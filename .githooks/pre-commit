#!/bin/sh
# EconomicDashboard pre-commit gate — G3, G4, G5, G9.
#
# Versioned deliberately. A hook in .git/hooks/ cannot be reviewed, diffed, or
# shared, and is exactly the "writable path that later gets executed" that agent
# security guidance warns about. Enable it once per clone:
#
#     git config core.hooksPath .githooks
#
# Bypass is possible with --no-verify. That is fine for a human who knows why;
# the agent's copy of this gate also runs inside merge_gate.py, which it cannot
# skip, so --no-verify buys nothing there.
#
# Plan: docs/plans/2026-08-12-002-feat-agent-autonomy-plan.md (U5)

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)

# Windows Git Bash usually has `python`, Linux/macOS usually `python3`.
PY=""
for c in python3 python py; do
    if command -v "$c" >/dev/null 2>&1 && "$c" -c "import sys" >/dev/null 2>&1; then
        PY="$c"; break
    fi
done

if [ -z "$PY" ]; then
    echo "pre-commit: no python found on PATH (tried python3, python, py)." >&2
    echo "The diff gates cannot run. Install Python, or commit with --no-verify" >&2
    echo "and understand that G3/G4/G5/G9 did NOT run." >&2
    exit 1
fi

exec "$PY" "$REPO_ROOT/scripts/diff_gates.py" --repo "$REPO_ROOT"
