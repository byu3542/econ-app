<?xml version="1.0" encoding="utf-8"?>
<!-- Plus Jakarta Sans, the Pantrii suite typeface (plan U2, KTD4). Static
     latin-subset TTFs from Fontsource, SIL Open Font License 1.1 — license
     text ships at assets/licenses/plus_jakarta_sans_OFL.txt. Glyphs outside
     the subset (e.g. ▲ ▼) fall back to the system font. Both android: and
     app: attributes so AppCompat's font loading resolves the same faces. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/plus_jakarta_sans_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/plus_jakarta_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/plus_jakarta_sans_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/plus_jakarta_sans_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/plus_jakarta_sans_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/plus_jakarta_sans_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        android:font="@font/plus_jakarta_sans_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/plus_jakarta_sans_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
    <font
        android:font="@font/plus_jakarta_sans_extrabold"
        android:fontStyle="normal"
        android:fontWeight="800"
        app:font="@font/plus_jakarta_sans_extrabold"
        app:fontStyle="normal"
        app:fontWeight="800" />
</font-family>
