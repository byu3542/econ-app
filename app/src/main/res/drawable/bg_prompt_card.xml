<?xml version="1.0" encoding="utf-8"?>
<!-- Pantrii port U4 (R2, R10): start-screen prompt card. Surface fill,
     hairline line stroke, 20dp radius, no elevation; ripple on press. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/line" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
</ripple>
