<?xml version="1.0" encoding="utf-8"?>
<!-- TICKET-23 — rounded background for the chart crosshair marker bubble.
     Pantrii port U10: a small surface card (surface fill, line hairline) in
     both themes, instead of navy with a gold stroke. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface" />
    <corners android:radius="@dimen/radius_badge" />
    <stroke android:width="1dp" android:color="@color/line" />
</shape>
