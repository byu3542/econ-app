<?xml version="1.0" encoding="utf-8"?>
<!--
  Draws a 1dp neutral hairline along the top edge of the BottomNavigationView.
  TICKET-43 follow-up: was 20% gold (#33C9A84C); a permanent gold rule spent
  accent budget on chrome, so it now matches @color/header_hairline_neutral.
  The bottom/left/right are pushed out so only the top stroke is visible.
  IOS-04: fill is alpha'd (was a solid #0f1729) so it reads as a translucent
  material with content passing underneath, not an opaque block.
  2026-07-27 nav fix: ~85% (#D9) → ~95% (#F2). At 85%, with no backdrop blur
  available, KPI cards scrolling under the bar stayed fully legible and fought
  with the nav labels.
  TICKET-56 (2026-09-01): fully opaque. At 95% headlines and KPI values still
  read through the bar; the depth cue now comes from bg_nav_scrim.xml (a 24dp
  fade sitting just above this bar) instead of from transparency. Content still
  travels under the bar on scroll (clipToPadding=false on every scrolling root).
  Keep in sync with @color/header_navy_translucent.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top border: 1dp neutral hairline -->
    <item
        android:bottom="-2dp"
        android:left="-2dp"
        android:right="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/header_hairline_neutral" />
            <solid android:color="@color/nav_bg" />
        </shape>
    </item>
</layer-list>
