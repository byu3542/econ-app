<?xml version="1.0" encoding="utf-8"?>
<!-- IOS-05: recessed track behind the segmented control's sliding thumb.
     A subtractive tint (translucent black) works on both the light and
     navy card surfaces this control appears on. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/radius_chip"/>
    <solid android:color="#14000000"/>
</shape>
