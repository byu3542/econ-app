<?xml version="1.0" encoding="utf-8"?>
<!-- IOS-05: the track behind the segmented control's sliding thumb.
     Pantrii port U10: a pill on surface_2 with a line hairline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/radius_pill"/>
    <solid android:color="@color/surface_2"/>
    <stroke android:width="1dp" android:color="@color/line"/>
</shape>
