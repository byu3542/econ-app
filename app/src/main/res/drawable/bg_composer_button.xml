<?xml version="1.0" encoding="utf-8"?>
<!-- Pantrii port U5 (R3): 52dp rounded-square composer button (attach, send).
     Hairline outline on surface; when enabled with state_activated (send with
     text, or Stop) it fills with the accent. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/line">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface" />
                    <stroke android:width="1dp" android:color="@color/line" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
