<?xml version="1.0" encoding="utf-8"?>
<!-- Pantrii port U6 (R6, R10, KTD11): inline chart and table card in the
     chat thread. Surface fill, 1dp line hairline, 20dp radius, no elevation.
     The ripple only shows on a clickable card (the table opens its sheet). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/line" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</ripple>
