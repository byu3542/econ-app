<?xml version="1.0" encoding="utf-8"?>
<!-- GENERATED by gen_wordmark.py. Launch splash motion: the two "ii" bars rise
     from the static first frame (splash_wordmark), dots pulse. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_wordmark">
    <target android:name="bar0">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="scaleY" android:valueFrom="0.15" android:valueTo="1"
                android:startOffset="150" android:duration="900"
                android:interpolator="@android:interpolator/linear_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="bar1">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="scaleY" android:valueFrom="0.15" android:valueTo="1"
                android:startOffset="300" android:duration="900"
                android:interpolator="@android:interpolator/linear_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="dot0">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0.3" android:valueTo="1"
                android:startOffset="0" android:duration="600"
                android:repeatCount="infinite" android:repeatMode="reverse" />
        </aapt:attr>
    </target>
    <target android:name="dot1">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0.3" android:valueTo="1"
                android:startOffset="200" android:duration="600"
                android:repeatCount="infinite" android:repeatMode="reverse" />
        </aapt:attr>
    </target>
    <target android:name="dot2">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0.3" android:valueTo="1"
                android:startOffset="400" android:duration="600"
                android:repeatCount="infinite" android:repeatMode="reverse" />
        </aapt:attr>
    </target>
</animated-vector>
