<?xml version="1.0" encoding="utf-8"?>
<!--
    Center-nav FAB artwork: the Economii "Twin i" logo on its navy disc,
    matching the launcher icon (ic_launcher_background + ic_launcher_foreground).

    Disc and ring are vector circle paths (anti-aliased) rather than relying on
    the MaterialCardView's clipToOutline crop, which is NOT anti-aliased.
    Ring color uses @color/fab_ring so it adapts to dark mode. The disc and its
    hairline take ?attr/econAccentBright, so the FAB follows the selected
    accent. The bar stems and the trend mark (line plus both dots) are black or
    white by theme: @color/fab_glyph_stem and @color/fab_glyph_mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer ring -->
    <path
        android:fillColor="@color/fab_ring"
        android:pathData="M54,1 a53,53 0 1,1 -0.01,0 z"/>

    <!-- Accent hairline -->
    <path
        android:fillColor="?attr/econAccentBright"
        android:pathData="M54,6.2 a47.8,47.8 0 1,1 -0.01,0 z"/>

    <!-- Accent disc -->
    <path
        android:fillColor="?attr/econAccentBright"
        android:pathData="M54,8.2 a45.8,45.8 0 1,1 -0.01,0 z"/>

    <!-- Twin i glyph, copied from ic_launcher_foreground and scaled to fill the disc -->
    <group android:pivotX="54" android:pivotY="54" android:scaleX="1.6" android:scaleY="1.6"
        android:translateY="0.3">
        <path android:pathData="M46,49 L62,40"
            android:strokeColor="@color/fab_glyph_mark" android:strokeWidth="3.2" android:strokeLineCap="round"/>
        <path android:pathData="M41.5,61.5 a4.5,4.5 0 0 1 9,0 v6 a4.5,4.5 0 0 1 -9,0 z"
            android:fillColor="@color/fab_glyph_stem"/>
        <path android:pathData="M57.5,52.5 a4.5,4.5 0 0 1 9,0 v15 a4.5,4.5 0 0 1 -9,0 z"
            android:fillColor="@color/fab_glyph_stem"/>
        <path android:pathData="M41.4,49 a4.6,4.6 0 1 0 9.2,0 a4.6,4.6 0 1 0 -9.2,0 z"
            android:fillColor="@color/fab_glyph_mark"/>
        <path android:pathData="M57.4,40 a4.6,4.6 0 1 0 9.2,0 a4.6,4.6 0 1 0 -9.2,0 z"
            android:fillColor="@color/fab_glyph_mark"/>
    </group>

</vector>
