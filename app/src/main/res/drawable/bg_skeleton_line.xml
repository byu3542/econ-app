<?xml version="1.0" encoding="utf-8"?>
<!--
  Text-line placeholder for shimmer skeletons (theme-aware via divider_sand).
  Same fill as bg_skeleton_block, but a 4dp radius — a 12dp radius on a 12dp-tall
  line renders as a lozenge rather than a line of text.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/divider_sand" />
    <corners android:radius="4dp" />
</shape>
