<?xml version="1.0" encoding="utf-8"?>
<!-- Dark theme palette. Navy data surfaces (header, KPI badges, charts,
     bottom nav) are already dark and keep their day values — only the
     light "reading" surfaces and their text flip here. -->
<resources>
    <!-- Pantrii-port semantic tokens, night half (palette B). The legacy
         names aliased onto these in values/colors.xml (bg_warm_off_white,
         surface_card, divider_sand, text_*, background, sheet_*) no longer
         carry night values of their own — they follow these tokens. -->
    <color name="ground">#0A0E18</color>
    <color name="surface">#131A29</color>
    <color name="surface_2">#1A2336</color>
    <color name="line">#26314A</color>
    <color name="ink">#EEEBE3</color>
    <color name="ink_2">#C9CCD6</color>
    <color name="muted">#97A0B5</color>
    <color name="accent">#E2B84B</color>
    <color name="on_accent">#17130A</color>
    <color name="accent_soft">#262014</color>

    <color name="row_alt_bg">#171C26</color>
    <color name="tab_bg_warm_gray">#1C222E</color>

    <color name="alabaster_dark_gray">#D8DCE6</color>

    <!-- R2-TICKET-09: badge greys get explicit night values so the light and dark
         badge can't silently diverge. Badge cards are navy in BOTH themes, so the
         day values are correct here — the entries exist to record that intent and
         to give every colour on the badge path a light + night pair.
         text_slate is the only grey a status word may use (@style/Badge.Status);
         dot_neutral is the pre-data placeholder dot. -->
    <color name="text_slate">#8A9AB5</color>
    <color name="dot_neutral">#9E9E9E</color>
    <color name="text_on_navy_muted">#8CFFFFFF</color>
    <!-- The two card surfaces a badge can sit on. Same reasoning: navy in both
         themes, declared here so the whole badge path is theme-complete. -->
    <color name="card_navy_badge">#1C2236</color>
    <color name="header_navy">#1a1a2e</color>
    <!-- 2026-07-27 nav fix: raised ~85% (#D9) → ~95% (#F2); TICKET-56
         2026-09-01: opaque. Matches values/colors.xml, see the comment there. -->
    <color name="header_navy_translucent">#FF1A1A2E</color>

    <color name="economy_tab_bg">#1C222E</color>
    <!-- TICKET-44: day value darkened for the light tab bg; on the dark night
         tab bg slate is the passing value (~5.6:1), so it lives on here. -->
    <color name="economy_tab_text_unselected">#8A9AB5</color>

    <color name="error_bubble_bg">#2A1E20</color>
    <color name="error_bubble_stroke">#5C3438</color>
    <color name="error_text">#FF8A93</color>

    <color name="chart_grid">#2A3142</color>
    <color name="chart_axis_line">#3A4358</color>
    <color name="chart_axis_text">#A9B1C2</color>
    <color name="chart_legend_text">#C5CCDB</color>

    <color name="hairline_on_surface">#1FFFFFFF</color>
    <color name="handle_on_surface">#33FFFFFF</color>
    <color name="header_hairline_neutral">#1FFFFFFF</color>


    <!-- Metric popup sheet surfaces: aliases onto the tokens since U1 (see
         values/colors.xml). TICKET-41's near-white body text holds — ink's
         night value is #EEEBE3, not pure white. -->

    <!-- Status signal palette. Badge cards are navy in both themes, so these keep
         their day values; declared here so the resource is theme-complete and badges
         re-theme correctly under values-night. -->
    <color name="signal_good">#6FA97A</color>
    <color name="signal_good_soft">#A9C4AE</color>
    <color name="signal_good_tint">#CBDCCE</color>
    <color name="signal_watch">#DCC873</color>
    <color name="signal_watch_soft">#E6DCA8</color>
    <color name="signal_watch_tint">#F0EAC8</color>
    <color name="signal_elevated">#D98E4F</color>
    <color name="signal_elevated_soft">#E5BE93</color>
    <color name="signal_elevated_tint">#F0DABF</color>
    <color name="signal_alert">#C75B4E</color>
    <color name="signal_alert_soft">#D9A099</color>
    <color name="signal_alert_tint">#EFD3D0</color>
    <color name="signal_alert_deep">#8E3B32</color>
    <color name="signal_imbalance">#8A6E9E</color>
    <color name="signal_good_cb">#009E73</color>
    <color name="signal_watch_cb">#F0E442</color>
    <color name="signal_elevated_cb">#E69F00</color>
    <color name="signal_alert_cb">#D55E00</color>
    <color name="signal_alert_deep_cb">#8C3D00</color>
    <color name="signal_imbalance_cb">#CC79A7</color>
</resources>
