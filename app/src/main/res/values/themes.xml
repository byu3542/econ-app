<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. DayNight — dark palette lives in values-night/colors.xml. -->
    <style name="Theme.EconomicDashboard" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="materialSwitchStyle">@style/Widget.Econ.Switch</item>
        <!-- Primary brand color: the Pantrii accent (was the legacy navy
             #1a1a2e), so widgets that tint from colorPrimary match the port. -->
        <item name="colorPrimary">?attr/econAccent</item>
        <item name="colorPrimaryDark">?attr/econAccent</item>
        <item name="colorOnPrimary">?attr/econOnAccent</item>
        <item name="colorAccent">?attr/econAccent</item>
        <!-- Settings parity U1: gold defaults for the accent attributes; the
             chosen ThemeOverlay.Economii.Accent.* overrides them. -->
        <item name="econAccent">@color/accent</item>
        <item name="econOnAccent">@color/on_accent</item>
        <item name="econAccentSoft">@color/accent_soft</item>
        <item name="econAccentBright">#E2B84B</item>

        <!-- Pantrii port U1: window paints the semantic ground token. Status and
             nav bars stay transparent (IOS-04 below) — the app draws edge to
             edge, so the ground or the header shows through them; painting
             the bars ground would put a light strip over the navy header. -->
        <item name="android:windowBackground">@color/ground</item>

        <!-- IOS-04: status/nav bars are transparent — the header and bottom-nav
             views are drawn behind the system bars via
             setDecorFitsSystemWindows(false).
             Pantrii port U9: the header is ground and the nav is surface now,
             not navy, so system-bar icons follow the theme (dark icons in
             light, light icons in night; values-night/bools.xml).
             windowTranslucentStatus is off: it made the system paint a grey
             scrim under the status bar, invisible over navy but a visible
             band over ground (the assistant cleared it by hand in U3). -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>

        <!-- Alabaster specific styling -->
        <item name="toolbarStyle">@style/AlabasterToolbar</item>
        <item name="tabStyle">@style/AlabasterTabLayout</item>

        <!-- Rounded long-press context menus (Ask AI Analyst / Explain chart / news) -->
        <item name="android:popupMenuStyle">@style/RoundedPopupMenu</item>
        <item name="popupMenuStyle">@style/RoundedPopupMenu</item>

        <!-- TICKET-54: dialogs inherit the app's own tokens instead of platform
             chrome. Also set on both BottomSheet themes below — they descend from
             Theme.MaterialComponents.DayNight.BottomSheetDialog, a sibling branch
             that does NOT pick up items set here, so a dialog built from a sheet's
             own context would otherwise fall back to platform chrome silently. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Econ.MaterialAlertDialog</item>

        <!-- Pantrii port U11: a BottomSheetDialogFragment that sets no style of
             its own (the indicator picker, the watchlist setup) opens on the
             same sheet theme as the ones that do. -->
        <item name="bottomSheetDialogTheme">@style/Theme.Econ.Sheet</item>

        <!-- IOS-03: tabular digits on every default TextView (see Widget.Econ.TextView
             below). Only affects numeral glyph widths — no visual change to
             non-numeric text — so this is safe app-wide rather than hand-picking
             every value/delta TextView and risking missing one. -->
        <item name="android:textViewStyle">@style/Widget.Econ.TextView</item>

        <!-- Pantrii port U2: Plus Jakarta Sans app-wide. A theme-level
             fontFamily is the last fallback TextView reads, and it beats the
             fontFamily inside a textAppearance — so Material buttons, chips
             and tabs (whose fonts live in their text appearances) switch too.
             A view or its style setting fontFamily itself still wins. Weight
             comes from textStyle: normal = 400, bold = 700. The app: twin is
             what AppCompat's text helper reads. -->
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <!-- IOS-03: default TextView style carrying tabular figures app-wide. Only
         plain <TextView>/AppCompatTextView elements resolve android:textViewStyle
         as their default style — Buttons, Chips, EditTexts etc. use their own
         Material default-style attrs and are untouched by this. -->
    <style name="Widget.Econ.TextView" parent="android:Widget.TextView">
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="RoundedPopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_rounded</item>
    </style>

    <!-- ── Dialogs (TICKET-54, Pantrii port U11) ───────────────────────────
         Dialogs carry forms and destructive actions; sheets carry data and
         charts. U11 puts both on the semantic tokens: a dialog is a surface
         panel with 24dp corners (above the 20dp card, below the 28dp sheet),
         an ink title in Jakarta bold, ink_2 body text, and one accent-filled
         pill as its primary button. That pill is a control, so it is the one
         place the accent may sit here (KTD10 rule 1). The secondary button
         stays a text button. A destructive dialog swaps the pill for red text
         at the call site (markDestructive, DialogStyle.kt).

         Mechanism notes, learned the same way EconomicBottomSheetStyle24 did:
         the dialog surface is backgroundTint on alertDialogStyle — NOT
         android:background, which MaterialAlertDialogBuilder never reads
         (R.styleable.MaterialAlertDialog carries only backgroundTint and the
         four insets). The title slot is a WIDGET style that must keep
         MaterialAlertDialog.MaterialComponents.Title.Text as its parent: the
         mtrl_alert_dialog_title layout declares no layout params of its own,
         so a text-appearance there crashes inflation. shapeAppearanceOverlay
         lives on alertDialogStyle, not the theme, so the 16dp reaches the
         dialog window and not every Material widget inflated inside it.
         Rationale: subprojects/ux-passes/DIALOG_THEME_DECISION_2026-08-17.md -->
    <style name="ShapeAppearance.Econ.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_dialog</item>
    </style>

    <style name="MaterialAlertDialog.Econ" parent="MaterialAlertDialog.MaterialComponents">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Econ.Dialog</item>
    </style>

    <!-- U11: the family is set here too. Material's title and message
         styles carry their own font through textAppearanceBody2/Headline6,
         so the theme-level Jakarta did not reach the message text. AppCompat's
         text helper reads the app: twin, so both are set. -->
    <style name="MaterialAlertDialog.Econ.Title.Text" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="MaterialAlertDialog.Econ.Body.Text" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <!-- The primary button: an accent-filled pill. Unelevated, so it stays
         flat like every other surface in the port. -->
    <style name="Button.Econ.Dialog.Positive" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">?attr/econAccent</item>
        <item name="android:textColor">?attr/econOnAccent</item>
        <item name="rippleColor">@color/hairline_on_surface</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginStart">@dimen/space_sm</item>
        <item name="android:paddingStart">@dimen/space_xl</item>
        <item name="android:paddingEnd">@dimen/space_xl</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Button.Econ.Dialog.Negative" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/ink_2</item>
        <item name="rippleColor">@color/ripple_dialog_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Neutral keeps the Flush parent so it stays left-aligned with the
         dialog content edge, per Material's default. No caller uses a neutral
         button today; this exists so the first one that does inherits the
         right thing. Destructive styling is NOT here — only some dialogs are
         destructive and a theme cannot know which, so the call site applies
         it after show() via AlertDialog.markDestructive() (DialogStyle.kt),
         the single owner of that colour. -->
    <style name="Button.Econ.Dialog.Neutral" parent="Widget.MaterialComponents.Button.TextButton.Dialog.Flush">
        <item name="android:textColor">@color/ink_2</item>
        <item name="rippleColor">@color/ripple_dialog_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="ThemeOverlay.Econ.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.Econ</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Econ.Title.Text</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.Econ.Body.Text</item>
        <item name="buttonBarPositiveButtonStyle">@style/Button.Econ.Dialog.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Button.Econ.Dialog.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/Button.Econ.Dialog.Neutral</item>
        <!-- U11: controls inside a dialog (the add-alert radios, the text
             field's focus ring and hint) take the accent. colorSecondary
             would otherwise fall back to Material's teal. -->
        <item name="colorPrimary">?attr/econAccent</item>
        <item name="colorSecondary">?attr/econAccent</item>
        <item name="colorOnSecondary">?attr/econOnAccent</item>
    </style>

    <style name="AlabasterToolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/cardBackground</item>
        <item name="titleTextColor">@color/textPrimary</item>
        <item name="subtitleTextColor">@color/textSecondary</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="AlabasterTabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="android:background">@color/cardBackground</item>
        <item name="tabIndicatorColor">@color/alabaster_dark_gray</item>
        <item name="tabSelectedTextColor">@color/textPrimary</item>
        <item name="tabTextColor">@color/textSecondary</item>
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabTextAppearance">@style/AlabasterTabTextAppearance</item>
    </style>

    <style name="AlabasterTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">@dimen/text_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ── Economy secondary tab row ─────────────────────────────────────── -->
    <!-- Pantrii port U10 (R10, KTD10): the Markets / Economy sub-tab row is a
         row of pill chips. The selected tab is a pill (accent_soft fill, accent
         hairline, ink text) drawn by the stretched indicator; unselected tabs
         are muted text on ground. tabIndicatorColor is transparent so
         TabLayout leaves the drawable's own fill and stroke untinted. -->
    <style name="EconomyTabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="android:background">@color/ground</item>
        <item name="android:layout_marginStart">@dimen/space_md</item>
        <item name="android:layout_marginEnd">@dimen/space_md</item>
        <item name="tabIndicator">@drawable/bg_chip_selected_inset</item>
        <item name="tabIndicatorColor">@android:color/transparent</item>
        <item name="tabIndicatorGravity">stretch</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabIndicatorAnimationMode">elastic</item>
        <item name="tabSelectedTextColor">@color/ink</item>
        <item name="tabTextColor">@color/muted</item>
        <item name="tabTextAppearance">@style/EconomyTabTextAppearance</item>
        <item name="tabRippleColor">@android:color/transparent</item>
    </style>

    <style name="EconomyTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ── Bottom navigation bar ─────────────────────────────────────────── -->
    <style name="BottomNavLabelStyle" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!--
      Suppresses the default Material pill/ripple indicator behind the nav icon
      so our custom 2dp top-line indicator (navActiveIndicator View) is used instead.
      No parent — the ActiveIndicator parent style name varies across MC versions.
    -->
    <style name="BottomNavActiveIndicatorNone">
        <item name="android:color">@android:color/transparent</item>
        <item name="android:height">0dp</item>
        <item name="android:width">0dp</item>
    </style>

    <!-- ── Sheets (Pantrii port U11, R10) ─────────────────────────────────
         ONE sheet theme for every bottom sheet: the metric popup, edit cards,
         the indicator picker, the watchlist setup and the answer actions. A
         surface panel with 28dp top corners and no elevation shadow; each
         sheet layout draws its own 40x4dp line handle (bg_sheet_handle, the
         one U6 introduced). Cards inside a sheet are Widget.Econ.Card, whose
         line stroke separates them from the surface they sit on. -->
    <style name="ShapeAppearance.Econ.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_sheet</item>
        <item name="cornerSizeTopRight">@dimen/radius_sheet</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- `android:background` is a no-op here and must NOT be relied on: once
         `shapeAppearanceOverlay` is set, BottomSheetBehavior's constructor
         (see BottomSheetBehavior_Layout in the Material library's attrs.xml)
         unconditionally builds its own MaterialShapeDrawable in
         createMaterialShapeDrawableIfNeeded() and replaces this view's
         background with it in onLayoutChild() — android:background is
         simply never read once shape theming is on. The drawable's fill
         comes from `backgroundTint` (a distinct attr from android:background)
         and, when that's unset, falls back to the theme's android:colorBackground
         — which under Theme.MaterialComponents.DayNight resolves to a plain
         light/white color regardless of the app's own navy palette. That
         fallback fill, painted at the exact same rounded geometry as
         MetricBottomSheet's own `wrap` clip but by an independently
         anti-aliased shape, is what showed through as a thin white halo
         tracing the rounded top corners. Setting `backgroundTint` explicitly
         to the same surface the `wrap` uses fixes it at the source (and
         means any residual sub-pixel seam is surface-on-surface, so
         invisible even if the two roundrects don't align exactly). -->
    <style name="Widget.Econ.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Econ.Sheet</item>
        <!-- Keep the 28dp corners when expanded. By default the behavior
             squares them off at the top, but these sheets stop short of the
             status bar (MetricBottomSheet's expanded offset), so the square
             corners showed behind the rounded content as white wedges. -->
        <item name="shouldRemoveExpandedCorners">false</item>
    </style>

    <style name="Theme.Econ.Sheet" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Econ.BottomSheet</item>
        <!-- TICKET-54: sibling branch of Theme.EconomicDashboard, so it must
             carry the dialog theme itself — see the comment on that theme. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Econ.MaterialAlertDialog</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
    </style>


    <!-- ── Settings sheet ─────────────────────────────────────────────────── -->
    <!-- IOS-08: inset-grouped section header — 13sp uppercase text_secondary,
         above each group (was 11sp Title Case text_muted). -->
    <style name="SettingsSectionHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginBottom">@dimen/space_sm</item>
    </style>

    <!-- Card that wraps each settings section. Pantrii port U11 (R10): the
         one card (surface, 20dp, 1dp line stroke), grouped rows inside it
         split by line hairlines, as in Pantrii's Settings. -->
    <style name="SettingsCard" parent="Widget.Econ.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_md</item>
        <item name="contentPadding">@dimen/space_lg</item>
        <item name="contentPaddingBottom">@dimen/space_md</item>
        <item name="contentPaddingTop">@dimen/space_md</item>
    </style>

    <!-- Switch: accent track when on (a control, KTD10 rule 1), muted when off. -->
    <!-- Settings parity U2 (R8, KTD5): every switch is the Pantrii pill.
         Set as the theme's materialSwitchStyle, so layouts need no style. -->
    <style name="Widget.Econ.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/switch_thumb_tint</item>
        <item name="trackTint">@color/switch_track_tint</item>
        <item name="trackDecorationTint">@android:color/transparent</item>
        <item name="thumbIcon">@null</item>
    </style>

    <!-- Settings parity U5 (R4): a destructive action is a plain red text row
         at the foot of its page, behind a confirm dialog. -->
    <style name="SettingsDestructiveRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_lg</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/error_text</item>
    </style>

    <!-- Settings parity U5 (R9, KTD4): the 40dp icon tile that leads every
         control row, the smaller sibling of the list rows' 44dp tile. -->
    <style name="SettingsRowIcon">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">@dimen/space_md</item>
        <item name="android:padding">9dp</item>
        <item name="android:background">@drawable/bg_settings_icon_tile</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/ink_2</item>
    </style>

    <!-- A SettingsRow that is not tappable (status and label rows). -->
    <style name="SettingsInfoRow" parent="SettingsRow">
        <item name="android:background">@null</item>
    </style>

    <!-- Pantrii port U11: the secondary button. A pill with a line hairline
         and ink text, for the settings data actions and the sheet's Dismiss. -->
    <style name="Widget.Econ.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/ink</item>
        <item name="strokeColor">@color/line</item>
        <item name="rippleColor">@color/hairline_on_surface</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="SettingsRowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="SettingsRowTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="SettingsRowSub">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_secondary</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <!-- Settings pickers (theme / startup tab / decimals / timeframe) are
         ui.views.SegmentedView since TICKET-55; no MDC toggle styles remain. -->

    <!-- Dismiss button on the metric popup sheet. U11: the secondary pill,
         not gold — the accent would sit right under the tier rows. -->
    <style name="BenchmarkDismissButton" parent="Widget.Econ.Button.Outlined">
        <item name="android:textSize">@dimen/text_secondary</item>
    </style>

    <!-- Shimmer skeleton placeholders (Overview) -->
    <style name="SkeletonRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:layout_marginBottom">@dimen/space_lg</item>
        <item name="android:baselineAligned">false</item>
    </style>
    <style name="SkeletonCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">130dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_skeleton_block</item>
    </style>

    <!-- ── Overview metric grouping (TICKET-05) ──────────────────────────── -->
    <!-- Neutral, all-caps label above each KPI cluster. -->
    <style name="MetricGroupHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <!-- TICKET-43 follow-up: neutral, so Card.Overline is the screen's only gold layer -->
        <item name="android:textColor">@color/muted</item>
        <item name="android:layout_marginBottom">@dimen/space_sm</item>
    </style>

    <!-- "Common region" holding a cluster's KPI cards. TICKET-58: the 1dp
         stroked box (bg_metric_group, now in _to_delete) drew a border around
         two already-bordered cards; the header above and the space_lg gap
         below are the grouping device now. -->
    <style name="MetricGroupRegion">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:baselineAligned">false</item>
    </style>

    <!-- Cold-start theme (launch variation C). The splash ground is the
         accent's bright value and the launcher logo builds on a navy disc
         (splash_logo_anim, 480 ms, plays once). MainActivity's exit listener
         (LaunchExit.kt) then shrinks the accent field to a ring around the logo
         and drops it into the Analyst FAB. This manifest theme is gold; on API
         33+ MainActivity swaps in the chosen accent's Starting.<Accent> theme
         with setSplashScreenTheme for the next cold launch. -->
    <style name="Theme.EconomicDashboard.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">#E2B84B</item>
        <item name="windowSplashScreenIconBackgroundColor">#1A3470</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_anim</item>
        <item name="windowSplashScreenAnimationDuration">480</item>
        <item name="postSplashScreenTheme">@style/Theme.EconomicDashboard</item>
    </style>

    <!-- One per accent; only the ground differs (the AccentPalette night/bright
         value). Android persists these by NAME via setSplashScreenTheme, so
         never rename them. -->
    <style name="Theme.EconomicDashboard.Starting.Gold">
