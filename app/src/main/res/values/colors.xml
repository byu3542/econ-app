<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Alabaster Report Design System -->
    <color name="bg_warm_off_white">#f5f3ef</color>
    <color name="header_navy">#1a1a2e</color>
    <!-- IOS-04: header/bottom-nav "material" — alpha over header_navy so
         content scrolling underneath registers as passing *behind* the bar
         rather than stopping at a solid opaque block.
         2026-07-27 nav fix: raised from ~85% (#D9) to ~95% (#F2). Without a
         real backdrop blur (see the MainActivity comment on why Android can't
         do one here), 85% let KPI values and news headlines read clearly
         through the bar and compete with the title / nav labels — the
         translucency looked like a rendering bug rather than a material. 95%
         keeps the depth cue while restoring legibility. Keep this in sync with
         bg_bottom_nav_border.xml's fill and values-night/colors.xml. -->
    <color name="header_navy_translucent">#F21A1A2E</color>
    <color name="card_white">#ffffff</color>
    <!-- Light/dark-flipping card surface. card_white stays literal white in both
         modes because many layouts use it as TEXT color on navy cards. -->
    <color name="surface_card">#ffffff</color>
    <color name="row_alt_bg">#faf9f7</color>
    <color name="divider_sand">#f0ede8</color>
    <color name="accent_gold">#c9a84c</color>
    <!-- Darker gold for bold text on white cards (chat key figures) -->
    <color name="gold_ink">#8F6F2A</color>
    <color name="tab_bg_warm_gray">#ede9e3</color>

    <color name="text_navy">#1a1a2e</color>
    <color name="text_secondary">#666666</color>
    <color name="text_muted">#bbbbbb</color>

    <!-- Dark badge cards (KPI grid, housing badges) -->
    <color name="card_navy_badge">#1C2236</color>
    <!-- R2-TICKET-01/09: the ONE grey a status badge word is allowed to use.
         Owned by @style/Badge.Status; has an explicit values-night twin so the
         badge greys can't drift apart across themes again. -->
    <color name="text_slate">#8A9AB5</color>
    <!-- R2-TICKET-08: neutral placeholder dot, shown until BenchmarkStyle.tintDot()
         supplies the tier colour. Was a #9e9e9e literal in drawable/dot_neutral.xml. -->
    <color name="dot_neutral">#9E9E9E</color>
    <!-- Translucent white on navy. NOT for status words (R2-TICKET-01 removed it
         from every badge) — still used for supporting copy on navy hero cards. -->
    <color name="text_on_navy_muted">#8CFFFFFF</color>
    <color name="text_on_navy_secondary">#A6FFFFFF</color>
    <color name="gold_muted">#99C9A84C</color>

    <!-- Chat error bubble -->
    <color name="error_bubble_bg">#FFF8F8</color>
    <color name="error_bubble_stroke">#EFD3D0</color>
    <color name="error_text">#B00020</color>

    <!-- Delta chips on KPI cards -->
    <color name="delta_good">#6FA97A</color>
    <color name="delta_bad">#C75B4E</color>
    <!-- Colorblind-safe delta palette (Okabe–Ito blue/orange), used when the
         "Colorblind-safe colors" setting is on. Direction is still carried by
         the ▲/▼ glyph + sign, so meaning survives even in grayscale. -->
    <color name="delta_good_cb">#0072B2</color>
    <color name="delta_bad_cb">#E69F00</color>

    <!-- Map missing names used in themes.xml -->
    <color name="cardBackground">@color/card_white</color>
    <color name="alabaster_dark_gray">#333333</color>
    <color name="textPrimary">@color/text_navy</color>
    <color name="textSecondary">@color/text_secondary</color>

    <!-- Legacy / Theme Compatibility -->
    <color name="colorPrimary">#1a1a2e</color>
    <color name="colorPrimaryDark">#1a1a2e</color>
    <color name="colorAccent">#c9a84c</color>
    <color name="background">#f5f3ef</color>

    <!-- Bottom Navigation -->
    <color name="nav_bg">#0f1729</color>

    <!-- Economy secondary tab row -->
    <color name="economy_tab_bg">#ede8df</color>
    <color name="economy_tab_text_unselected">#8a9ab5</color>

    <!-- Theme-aware chart styling (light-surface charts via ChartHelper) -->
    <color name="chart_grid">#EEEEEE</color>
    <color name="chart_axis_line">#CCCCCC</color>
    <color name="chart_axis_text">#888888</color>
    <color name="chart_legend_text">#555555</color>

    <!-- Theme-aware hairlines/handles on flipping surfaces -->
    <color name="hairline_on_surface">#14000000</color>
    <color name="handle_on_surface">#26000000</color>

    <!-- Center-nav AI FAB: ring reads against both page bg and nav bar;
         disc gold matches ic_fab_gold_ai artwork (#D2B156) -->
    <color name="fab_ring">#f5f3ef</color>
    <color name="fab_gold">#D2B156</color>
    <!-- ── Semantic tokens (moved out of layout hex literals) ── -->
    <!-- Navy-surface structure -->
    <color name="navy_divider">#2A3342</color>
    <color name="navy_surface_deep">#1F2633</color>
    <color name="slate_dim">#5A6A8A</color>
    <color name="slate_soft">#8899BB</color>
    <!-- Status signal palette (muted to fit the navy/gold scheme) -->
    <color name="signal_good">#6FA97A</color>
    <color name="signal_good_soft">#A9C4AE</color>
    <color name="signal_good_tint">#CBDCCE</color>
    <color name="signal_watch">#DCC873</color>
    <color name="signal_watch_soft">#E6DCA8</color>
    <color name="signal_watch_tint">#F0EAC8</color>
    <color name="signal_elevated">#D98E4F</color>
    <color name="signal_elevated_soft">#E5BE93</color>
    <color name="signal_elevated_tint">#F0DABF</color>
    <color name="signal_alert">#C75B4E</color>
    <color name="signal_alert_soft">#D9A099</color>
    <color name="signal_alert_tint">#EFD3D0</color>
    <color name="signal_alert_deep">#8E3B32</color>
    <!-- Purple = "too much of a good thing" (imbalance): GDP overheating, extreme curve steepness. Never reused for "very strong/best". -->
    <color name="signal_imbalance">#8A6E9E</color>
    <!-- Colorblind-safe status set (Okabe-Ito), swapped in when colorblind mode is on. Distinct luminance for grayscale. -->
    <color name="signal_good_cb">#009E73</color>
    <color name="signal_watch_cb">#F0E442</color>
    <color name="signal_elevated_cb">#E69F00</color>
    <color name="signal_alert_cb">#D55E00</color>
    <color name="signal_alert_deep_cb">#8C3D00</color>
    <color name="signal_imbalance_cb">#CC79A7</color>
    <!-- Informational accents -->
    <color name="info_blue">#5B8DB8</color>
    <color name="info_blue_soft">#B3C9DD</color>
    <color name="info_blue_tint">#E3EAF4</color>
    <color name="accent_purple">#8A6E9E</color>
    <color name="accent_purple_soft">#D3C4DC</color>
    <color name="google_blue">#4285F4</color>
    <color name="google_amber">#FBBC04</color>
    <!-- Alpha overlays -->
    <color name="white_70">#B3FFFFFF</color>
    <color name="white_28">#47FFFFFF</color>
    <color name="navy_ripple">#331A1A2E</color>
    <color name="gold_hairline">#2EC9A84C</color>
    <!-- IOS-02 follow-up (2026-07-27): neutral hairline for the persistent
         header bar's bottom edge, split out of gold_hairline (see
         headerSeparator in activity_main.xml). header_container stays navy in
         both themes, so this doesn't need a values-night twin with a
         different value — declared there anyway, identically, for the same
         reason header_navy is. -->
    <color name="header_hairline_neutral">#1FFFFFFF</color>
</resources>
