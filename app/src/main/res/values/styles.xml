<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════════════
     SHARED TEXT APPEARANCES — the single source of truth for repeated elements.
     Added by BADGE_TICKETS_R2 (R2-TICKET-01 / R2-TICKET-07).

     Before this file existed there was nowhere for a shared text appearance to
     live, so every screen re-declared the badge word's colour/size/weight/caps/
     tracking in its own layout — three greys, two sizes, two weights. If you are
     adding a status badge or a gold card overline to a NEW screen, apply one of
     these styles; do NOT re-declare android:textColor / android:textSize inline.
     scripts/check_badges.sh fails the build if you do.
     ═══════════════════════════════════════════════════════════════════════════ -->
<resources>

    <!-- R2-TICKET-01: the canonical status badge word.
         11 sp, bold, all-caps, 0.08 tracking, slate. Used by
         layout/view_status_badge.xml, which is the only place a badge row is
         declared. Nothing else should set these five attributes on a status
         TextView. -->
    <style name="Badge.Status" parent="">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_slate</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- R2-TICKET-07: the gold overline label above a KPI value.
         Was six different variants (11/13/15 sp, tracking 0 / 0.08 / 0.1, two of
         them not even all-caps). Overlines must stay short enough to fit one
         line at 360 dp — put any qualifier on the description line under the
         badge instead. -->
    <!-- Pantrii port U10 (KTD10 rule 1): muted, not gold. The overline sits
         beside a status badge, and gold text next to a WATCH badge reads as
         one state. -->
    <style name="Card.Overline" parent="">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Pantrii port U10 (R10): THE card. Every KPI, panel and chart card in
         the tabs uses it; there is no navy or gold variant any more. A card
         that drives the chart below it swaps its stroke through
         BenchmarkStyle.setCardActive, never through a foreground drawable
         (MaterialCardView draws this stroke in its foreground). -->
    <style name="Widget.Econ.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">@dimen/stroke_card</item>
        <item name="rippleColor">@color/hairline_on_surface</item>
    </style>

    <!-- ── Type roles (Pantrii port U2) ─────────────────────────────────────
         One typeface, Plus Jakarta Sans, everywhere — figures included
         (decided 2026-10-13: no serif numerals). The theme already sets the
         family; these roles fix size and weight per job. Colour is left to
         the call site. Weight comes from textStyle (normal 400, bold 700):
         a theme-level fontFamily outranks the one inside a textAppearance,
         so a role cannot pick 500/600/800 by family — set that on the view. -->
    <style name="TextAppearance.Econ" parent="android:TextAppearance">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
    </style>
    <style name="TextAppearance.Econ.Display">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.Econ.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Econ.Body">
        <item name="android:textSize">@dimen/text_body</item>
    </style>
    <style name="TextAppearance.Econ.Caption">
        <item name="android:textSize">@dimen/text_secondary</item>
    </style>
    <style name="TextAppearance.Econ.Label">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <!-- The number role: every figure. Tabular digits so a count-up value or
         a column of numbers never shifts horizontally. Switching this one
         style re-sets every figure that uses it. -->
    <style name="TextAppearance.Econ.Number">
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>


    <!-- TICKET-57: the one chart-card / panel title, bold in ink on the
         surface card (navy panels until Pantrii port U10). Was serif until the Pantrii port; now the title role.
         Apply with android:textAppearance and set NO inline textColor /
         textSize / fontFamily / textStyle on the same view (those override
         the appearance silently). -->
    <style name="TextAppearance.Econ.PanelTitle" parent="TextAppearance.Econ.Title">
        <item name="android:textColor">@color/ink</item>
    </style>

    <!-- AIC-05: text button in the row under an analyst answer. 48dp tall so
         the small label still has a full touch target. -->
    <style name="ChatAnswerAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/space_sm</item>
        <item name="android:paddingEnd">@dimen/space_sm</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

</resources>
