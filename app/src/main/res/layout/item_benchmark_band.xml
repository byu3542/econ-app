<?xml version="1.0" encoding="utf-8"?>
<!-- One tier row in a metric popup's BENCHMARKS pane (mockup 1c). Inflated at
     runtime from MetricPopupRegistry.MetricPopupSpec.bands — no row exists
     without a matching Kotlin entry, which is what the old hand-typed
     dialog_*_status.xml rows could drift out of sync with Benchmarks.kt on. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="@dimen/space_md"
    android:paddingHorizontal="@dimen/space_sm">

    <!-- Pantrii port U11 (KTD10 rule 2): the tier's glyph disc, as on the
         status badge (BenchmarkStyle.glyphDisc). The label beside it already
         names the tier, so TalkBack skips the glyph. -->
    <TextView
        android:id="@+id/tvBandGlyph"
        android:layout_width="@dimen/badge_glyph_disc"
        android:layout_height="@dimen/badge_glyph_disc"
        android:layout_marginEnd="@dimen/space_lg"
        android:background="@drawable/dot_neutral"
        android:gravity="center"
        android:textSize="@dimen/badge_glyph_text"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvBandLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tvBandRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_secondary" />

    </LinearLayout>

</LinearLayout>
