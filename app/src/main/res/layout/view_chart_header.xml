<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-10-16 unified chart header: the status pill over the latest value,
     right-aligned, lifted from view_chat_chart.xml so every chart in the app
     (chat card, metric sheet, tab pages) reads the same way. Bound by
     views/ChartStatusHeader.kt. The pill stays gone for ungraded series. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llChartHeaderBlock"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/llChartPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:id="@+id/viewChartPillDot"
            android:layout_width="@dimen/dot_pill"
            android:layout_height="@dimen/dot_pill"
            android:layout_marginEnd="@dimen/space_xs"
            android:background="@drawable/dot_neutral"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvChartPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Econ.Label"
            android:letterSpacing="0.03"
            android:textColor="@color/muted" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvChartValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Econ.Number"
        android:textSize="17sp"
        android:textColor="@color/ink" />
</LinearLayout>
