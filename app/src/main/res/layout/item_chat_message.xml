<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/space_lg"
    android:paddingVertical="@dimen/space_sm"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Sender Label (YOU / ECON ANALYST) — shown only on the first message of a run -->
    <TextView
        android:id="@+id/tvSenderLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="YOU"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="@dimen/space_xs"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0" />

    <!-- Message Bubble -->
    <LinearLayout
        android:id="@+id/llBubbleContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingVertical="@dimen/space_md"
        android:minWidth="60dp"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginTop="@dimen/space_hairline"
        app:layout_constraintTop_toBottomOf="@id/tvSenderLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintWidth_default="wrap">

        <!-- MOT-02: thinking trace (trace rows only) -->
        <include layout="@layout/item_chat_trace" />

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_navy"
            android:textSize="@dimen/text_body"
            android:textIsSelectable="false"
            android:lineSpacingExtra="4dp" />

        <!-- Attached image (vision messages) -->
        <ImageView
            android:id="@+id/ivChatImage"
            android:layout_width="180dp"
            android:layout_height="120dp"
            android:layout_marginTop="@dimen/space_sm"
            android:scaleType="centerCrop"
            android:contentDescription="Attached image"
            android:visibility="gone" />

        <!-- TICKET-P2-2: charts the analyst asked for via render_chart. One
             view_chat_chart row per call, so a reply can carry several — the
             old [CHART:...] tag could only ever address one. -->
        <LinearLayout
            android:id="@+id/llChartContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- MOT-04: sources the turn's tools actually fetched (finished answers
             only). Builds its own children; hidden when there are none. -->
        <com.economic.dashboard.ui.views.SourceStackView
            android:id="@+id/sourceStack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:visibility="gone" />

        <!-- Explicit retry affordance for error bubbles -->
        <TextView
            android:id="@+id/tvRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="↻  Retry"
            android:textSize="@dimen/text_secondary"
            android:textStyle="bold"
            android:textColor="@color/error_text"
            android:background="@drawable/bg_retry_pill"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingVertical="@dimen/space_xs"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <!-- Typing Indicator Container -->
        <LinearLayout
            android:id="@+id/llTypingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_xs"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone">

            <View
                android:id="@+id/dot1"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_neutral"
                android:backgroundTint="@color/text_navy"
                android:layout_marginEnd="@dimen/space_xs" />

            <View
                android:id="@+id/dot2"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_neutral"
                android:backgroundTint="@color/text_navy"
                android:layout_marginEnd="@dimen/space_xs" />

            <View
                android:id="@+id/dot3"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_neutral"
                android:backgroundTint="@color/text_navy" />

        </LinearLayout>

    </LinearLayout>

    <!-- AIC-05: action row under a finished analyst answer -->
    <LinearLayout
        android:id="@+id/llAnswerActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/llBubbleContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0">

        <TextView
            android:id="@+id/btnAnswerCopy"
            style="@style/ChatAnswerAction"
            android:text="Copy" />

        <TextView
            android:id="@+id/btnAnswerRegenerate"
            style="@style/ChatAnswerAction"
            android:text="Regenerate" />

        <TextView
            android:id="@+id/btnAnswerContinue"
            style="@style/ChatAnswerAction"
            android:text="Continue" />

        <TextView
            android:id="@+id/btnVariantPrev"
            style="@style/ChatAnswerAction"
            android:contentDescription="Previous answer"
            android:text="‹" />

        <TextView
            android:id="@+id/tvVariantCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_caption"
            android:text="1/2" />

        <TextView
            android:id="@+id/btnVariantNext"
            style="@style/ChatAnswerAction"
            android:contentDescription="Next answer"
            android:text="›" />

        <TextView
            android:id="@+id/tvAnswerModel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_caption"
            android:text="Haiku 4.5" />
    </LinearLayout>

    <!-- Timestamp -->
    <TextView
        android:id="@+id/tvTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="9:38 AM"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_caption"
        android:layout_marginTop="@dimen/space_xs"
        app:layout_constraintTop_toBottomOf="@id/llAnswerActions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0" />

</androidx.constraintlayout.widget.ConstraintLayout>
