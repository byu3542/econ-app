<?xml version="1.0" encoding="utf-8"?>
<!-- Pantrii port U6 (R4, KTD6): one thread row. User messages are an accent
     bubble on the right; analyst answers are plain full-width text with no
     bubble, sender label or action row. Copy, regenerate, variants, the model
     label and the time open from a long-press sheet (AnswerActionsSheet).
     U7: a pending reply is one loader row; the answer replaces it whole.
     ChatAdapter sets the bubble's background, padding and width per row. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/space_lg"
    android:paddingVertical="7dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- AIC-08: history-cut divider, above the oldest question still sent to the analyst -->
    <TextView
        android:id="@+id/tvHistoryCut"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center"
        android:paddingVertical="@dimen/space_sm"
        android:layout_marginBottom="@dimen/space_sm"
        android:text="@string/chat_history_cut"
        android:textColor="@color/muted"
        android:textSize="@dimen/text_caption"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Message: a bubble for user and error rows, bare for answers -->
    <LinearLayout
        android:id="@+id/llBubbleContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tvHistoryCut"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintWidth_default="wrap">

        <!-- U7 (R5): loader row only — spinner and rotating phrase -->
        <include layout="@layout/view_assistant_loader" />

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Econ.Body"
            android:textColor="@color/ink"
            android:textIsSelectable="false"
            android:lineSpacingExtra="4dp" />

        <!-- Attached image (vision messages) -->
        <ImageView
            android:id="@+id/ivChatImage"
            android:layout_width="180dp"
            android:layout_height="120dp"
            android:layout_marginTop="@dimen/space_sm"
            android:scaleType="centerCrop"
            android:contentDescription="Attached image"
            android:visibility="gone" />

        <!-- TICKET-P2-2: charts the analyst asked for via render_chart. One
             view_chat_chart row per call, so a reply can carry several — the
             old [CHART:...] tag could only ever address one. -->
        <LinearLayout
            android:id="@+id/llChartContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone" />

        <!-- AIC-11: a newer release of a series this answer used is out -->
        <TextView
            android:id="@+id/tvStaleData"
            style="@style/Badge.Status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/chat_stale_data"
            android:visibility="gone" />

        <!-- MOT-04: sources the turn's tools actually fetched (finished answers
             only). Builds its own children; hidden when there are none. -->
        <com.economic.dashboard.ui.views.SourceStackView
            android:id="@+id/sourceStack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:visibility="gone" />

        <!-- Explicit retry affordance for error bubbles -->
        <TextView
            android:id="@+id/tvRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="36dp"
            android:gravity="center_vertical"
            android:text="↻  Retry"
            android:textAppearance="@style/TextAppearance.Econ"
            android:textSize="@dimen/text_secondary"
            android:textStyle="bold"
            android:textColor="@color/error_text"
            android:background="@drawable/bg_retry_pill"
            android:paddingHorizontal="@dimen/space_md"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
