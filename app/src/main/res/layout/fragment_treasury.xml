<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm_off_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="@dimen/space_lg">

            <!-- NOTE (2026-07-24): nothing currently inflates fragment_treasury.xml —
                 the Treasury tab is hosted by fragment_markets_host and the spread
                 cards live in fragment_spreads.xml. Kept in sync with the rest of
                 the app so it isn't a stale template if it's ever wired back up.

                 R2-TICKET-06: values were @dimen/text_display (28sp), a fourth step
                 in the ramp that existed only here; now @dimen/text_display_lg like
                 every other KPI value. -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSpreadYoY"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_sm"
                app:cardCornerRadius="@dimen/radius_card_kpi"
                app:cardElevation="@dimen/elevation_card_kpi"
                app:cardBackgroundColor="@color/card_navy_badge">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg"
                    android:gravity="center">

                    <TextView
                        style="@style/Card.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10Y - 2Y" />

                    <TextView
                        android:id="@+id/tvSpreadValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/card_white"
                        android:textSize="@dimen/text_display_lg"
                        android:fontFamily="serif"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/space_xs"/>

                    <include
                        android:id="@+id/statusSpread2Y"
                        layout="@layout/view_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 10Y-3M SPREAD CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSpread3M"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_sm"
                app:cardCornerRadius="@dimen/radius_card_kpi"
                app:cardElevation="@dimen/elevation_card_kpi"
                app:cardBackgroundColor="@color/card_navy_badge">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg"
                    android:gravity="center">

                    <TextView
                        style="@style/Card.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10Y - 3M" />

                    <TextView
                        android:id="@+id/tvSpread3MValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/card_white"
                        android:textSize="@dimen/text_display_lg"
                        android:fontFamily="serif"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/space_xs"/>

                    <include
                        android:id="@+id/statusSpread3M"
                        layout="@layout/view_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- 10Y-2Y SPREAD TREND SECTION -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2xl"
            app:cardCornerRadius="@dimen/radius_card_panel"
            app:cardElevation="@dimen/elevation_card_panel"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" >

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/header_navy"
                    android:paddingHorizontal="@dimen/space_xl"
                    android:paddingVertical="@dimen/space_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10Y-2Y Spread Trend"
                        android:textColor="@color/card_white"
                        android:textSize="@dimen/text_title"
                        android:fontFamily="serif"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_alignParentBottom="true"
                        android:background="@color/accent_gold" />
                </RelativeLayout>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/spreadChart"
                    android:importantForAccessibility="yes"
                    android:contentDescription="10-year minus 2-year Treasury spread chart"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:padding="@dimen/space_md"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 10Y-3M SPREAD TREND SECTION -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2xl"
            app:cardCornerRadius="@dimen/radius_card_panel"
            app:cardElevation="@dimen/elevation_card_panel"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" >

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/header_navy"
                    android:paddingHorizontal="@dimen/space_xl"
                    android:paddingVertical="@dimen/space_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10Y-3M Spread Trend"
                        android:textColor="@color/card_white"
                        android:textSize="@dimen/text_title"
                        android:fontFamily="serif"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_alignParentBottom="true"
                        android:background="@color/accent_gold" />
                </RelativeLayout>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/spread3MChart"
                    android:importantForAccessibility="yes"
                    android:contentDescription="10-year minus 3-month Treasury spread chart"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:padding="@dimen/space_md"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TREASURY YIELD CURVE SECTION -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2xl"
            app:cardCornerRadius="@dimen/radius_card_panel"
            app:cardElevation="@dimen/elevation_card_panel"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/header_navy"
                    android:paddingHorizontal="@dimen/space_xl"
                    android:paddingVertical="@dimen/space_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Yield Curve"
                        android:textColor="@color/card_white"
                        android:textSize="@dimen/text_title"
                        android:fontFamily="serif"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_alignParentBottom="true"
                        android:background="@color/accent_gold" />
                </RelativeLayout>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/yieldCurveChart"
                    android:importantForAccessibility="yes"
                    android:contentDescription="Treasury yield curve chart"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:padding="@dimen/space_md"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 10-YEAR TREASURY YIELD TREND SECTION -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2xl"
            app:cardCornerRadius="@dimen/radius_card_panel"
            app:cardElevation="@dimen/elevation_card_panel"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/header_navy"
                    android:paddingHorizontal="@dimen/space_xl"
                    android:paddingVertical="@dimen/space_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10-Year Trend"
                        android:textColor="@color/card_white"
                        android:textSize="@dimen/text_title"
                        android:fontFamily="serif"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_alignParentBottom="true"
                        android:background="@color/accent_gold" />
                </RelativeLayout>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/tenYearTrendChart"
                    android:importantForAccessibility="yes"
                    android:contentDescription="10-year Treasury yield trend chart"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:padding="@dimen/space_md"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
