<?xml version="1.0" encoding="utf-8"?>
<!--
  Refactored layout:
    • Header block (navy) — now includes settings gear top-right
    • FrameLayout (fragmentContainer) — hosts Overview / Markets / Economy fragments
    • FrameLayout wrapper at the bottom:
        – navActiveIndicator View (2dp gold line that slides to active item)
        – BottomNavigationView (4 destinations)

  The FAB and old TabLayout+ViewPager2 have been removed.
-->
<!--
  IOS-04: header/bottomNavWrapper are translucent "materials" that float on
  top of an edge-to-edge fragmentContainer (declared first == bottom of
  z-order in a CoordinatorLayout), instead of being opaque siblings that
  reserve their own fixed space in a vertical LinearLayout. Each screen's own
  scrolling root pads itself to clear both bars (see EdgeToEdgeInsets /
  MainActivity's insets listener) and disables clipToPadding so it can still
  scroll up underneath them.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm_off_white">

        <!-- ══ 2. FRAGMENT CONTAINER — hosts Overview / Markets / Economy ══
             Declared first so it sits behind the header and bottom nav.
             Edge-to-edge: no padding of its own — each fragment's own
             scrolling root pads itself (see EdgeToEdgeInsets). -->
        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- ══ 1. SLIM HEADER — single row ════════════════ -->
        <LinearLayout
            android:id="@+id/header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@color/header_navy_translucent"
            android:clipChildren="false"
            android:orientation="vertical">

            <!-- Persistent bar: a single compact, centered title, shared by
                 all four tabs. IOS-02 briefly gave Overview a large serif
                 masthead (+ quarter pill) that lived in its scroll content
                 and collapsed into this bar on scroll (LargeTitleController);
                 reverted 2026-07-28 per design direction back to a plain
                 static header everywhere — tvHeaderCompactTitle now stays at
                 alpha=1 on every tab (see resetHeaderCompactAlwaysVisible()
                 in MainActivity).
                 2026-07-27 follow-up: no vertical padding here — the bar's
                 content height is now defined entirely by btnSettings' own
                 (negative-margin) height below, targeting iOS's 44dp compact
                 bar instead of the ~69dp this padding used to add on top of
                 a 48dp icon. clipChildren=false so the icon's touch target
                 can overflow this box's edges without being clipped. -->
            <FrameLayout
                android:id="@+id/header_inner_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:paddingStart="@dimen/space_lg"
                android:paddingEnd="@dimen/space_lg">

                <TextView
                    android:id="@+id/tvHeaderCompactTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Overview"
                    android:textSize="17sp"
                    android:textColor="@color/card_white"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>

                <!-- 48dp touch target preserved (UX_DESIGN_LAWS.md Law 4,
                     Fitts's Law: "Minimum touch target 48x48dp") via -2dp
                     top/bottom margins rather than shrinking the ImageView
                     itself: the view stays 48dp and overflows the
                     FrameLayout's box by 2dp on each edge, but only
                     contributes 44dp (48 - 2 - 2) to this FrameLayout's
                     wrap_content height — the same 44dp the compact bar
                     targets. -->
                <ImageView
                    android:id="@+id/btnSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="-2dp"
                    android:layout_marginBottom="-2dp"
                    android:layout_gravity="end|center_vertical"
                    android:padding="@dimen/space_md"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="@string/settings"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/white_70"/>

                <!-- TICKET-58: "Edit cards" moved off the Overview's first row into
                     the header, left of the gear. Same 48dp target; MainActivity
                     shows it only while Overview is the visible tab. -->
                <ImageView
                    android:id="@+id/btnEditCards"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="-2dp"
                    android:layout_marginBottom="-2dp"
                    android:layout_marginEnd="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:padding="@dimen/space_md"
                    android:src="@drawable/ic_edit"
                    android:contentDescription="@string/edit_dashboard_button"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/white_70"/>

            </FrameLayout>

            <!-- 0.5dp neutral hairline under the persistent bar. Always
                 visible (alpha=1, every tab — see
                 resetHeaderCompactAlwaysVisible() in MainActivity).
                 2026-07-27 follow-up: this used to double as both this
                 hairline AND the identity gold rule under Overview's large
                 masthead (1dp @color/gold_hairline), which read as a heavy
                 border once it was the only thing under a compact title.
                 That large-masthead state was later removed entirely
                 (2026-07-28), so this View is now simply the one neutral
                 hairline every tab's compact bar uses. -->
            <View
                android:id="@+id/headerSeparator"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_hairline_height"
                android:background="@color/header_hairline_neutral" />

        </LinearLayout>

        <!-- ══ Progress bar — anchored to the header's bottom edge instead of
             taking its own row in a vertical stack, now that the header
             floats over the edge-to-edge fragmentContainer. ════════════════ -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:indeterminate="true"
            android:visibility="gone"
            android:progressTint="@color/accent_gold"
            app:layout_anchor="@id/header_container"
            app:layout_anchorGravity="bottom" />

        <!-- ══ 3. BOTTOM NAV WRAPPER — translucent material, floats over the
             edge-to-edge fragmentContainer.
             The FrameLayout lets the navActiveIndicator View float at the
             very top edge of the nav bar so it appears as a 2dp top-line
             indicator above the active destination icon.
        ═════════════════════════ -->
        <!-- TICKET-56: 24dp fade sitting on the bar's top edge (anchored so it
             follows the wrapper's measured height, incl. system-bar padding).
             Declared before the wrapper and at 0 elevation, so it draws over
             the fragment and under the FAB (8dp elevation). MainActivity
             toggles it with the wrapper (Settings hides both). -->
        <View
            android:id="@+id/navScrim"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:background="@drawable/bg_nav_scrim"
            android:importantForAccessibility="no"
            app:layout_anchor="@id/bottomNavWrapper"
            app:layout_anchorGravity="top"
            android:layout_gravity="top" />

        <!-- TICKET-56: the wrapper carries the bar color itself, so the
             system-gesture inset it pads for (MainActivity insets listener)
             is bar material too — before, that strip was transparent and
             the list's last rows showed through under the nav labels. -->
        <FrameLayout
            android:id="@+id/bottomNavWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/nav_bg">

            <!-- BottomNav declared FIRST so it is drawn beneath the indicator -->
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottomNav"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:background="@drawable/bg_bottom_nav_border"
                app:itemIconSize="28dp"
                app:itemPaddingTop="12dp"
                app:itemPaddingBottom="16dp"
                app:menu="@menu/bottom_nav_menu"
                app:itemIconTint="@color/bottom_nav_icon_color"
                app:itemTextColor="@color/bottom_nav_text_color"
                app:itemTextAppearanceActive="@style/BottomNavLabelStyle"
                app:itemTextAppearanceInactive="@style/BottomNavLabelStyle"
                app:labelVisibilityMode="labeled"
                app:itemActiveIndicatorStyle="@style/BottomNavActiveIndicatorNone"
                app:elevation="0dp" />

            <!--
              Gold indicator line declared LAST so it is drawn on top of the
              BottomNav's solid navy background.  In a FrameLayout the last
              child wins the z-order — declaring it first (as before) meant
              the nav background painted over it completely.
              Width and TranslationX are set in MainActivity inside post().
            -->
            <!--
              Width is set to 60% of itemWidth in code (matching mockup inset of 20% each side).
              TranslationX accounts for the 20% left inset when centering per item.
              bg_nav_indicator gives it 2dp bottom-corner rounding (squared top, pill bottom).
            -->
            <View
                android:id="@+id/navActiveIndicator"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_gravity="top|start"
                android:background="@drawable/bg_nav_indicator"
                android:importantForAccessibility="no" />

        </FrameLayout>

    <!-- ══ 4. CENTER AI ANALYST BUTTON ═════════════
         Circular launcher-icon artwork with a gold ring, anchored so it
         straddles the top edge of the bottom nav (pantrii-style FAB).
         Opens AiAnalystBottomSheet — wired in MainActivity.
    ═════════════════════════ -->
    <!-- TICKET-56: card in the bar's own color with the artwork inset 4dp,
         so the part of the disc that overhangs the bar has bar material
         behind it and scrolling text passes behind a ring, never straight
         under the gold.
         Sized and placed like Pantrii's center button: 82dp card (74dp
         artwork), center 25dp below the bar's top edge so it lines up with
         the tab icons (12dp padding + 28dp icon) and only ~12dp overhangs. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fabAiAnalyst"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:layout_gravity="center"
        android:translationY="25dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Ask Econ Analyst"
        app:cardCornerRadius="41dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/nav_bg"
        app:rippleColor="@color/navy_ripple"
        app:strokeWidth="0dp"
        app:layout_anchor="@id/bottomNavWrapper"
        app:layout_anchorGravity="top|center_horizontal">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:src="@drawable/ic_fab_logo"
            android:scaleType="fitXY"
            android:importantForAccessibility="no" />

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
