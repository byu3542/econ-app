<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_md"
    android:layout_marginTop="@dimen/space_sm"
    android:layout_marginBottom="@dimen/space_sm"
    app:cardElevation="3dp"
    app:cardCornerRadius="12dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Gold accent bar at top -->
        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/accent_gold" />

        <ImageView
            android:id="@+id/iv_hero_thumb"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/news_featured_image"
            android:visibility="gone" />

        <!-- Source row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_xs">

            <TextView
                android:id="@+id/tv_hero_source"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:textColor="@color/accent_gold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/news_top_story"
                android:textColor="@color/gold_ink"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <!-- TICKET-59: middle-dot separator, same grammar as the row cards -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_xs"
                android:text="@string/news_meta_separator"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/text_muted"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tv_hero_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/text_muted" />

            <!-- TICKET-59: labelled Analyze chip, see item_news_row.xml -->
        <TextView
                android:id="@+id/btn_hero_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:gravity="center"
                android:layout_marginStart="@dimen/space_sm"
                android:paddingHorizontal="@dimen/space_md"
                android:background="@drawable/bg_pill_navy"
                android:drawableStart="@drawable/ic_sparkle_12"
                android:drawableTint="@color/accent_gold"
                android:drawablePadding="@dimen/space_xs"
                android:text="@string/news_analyze_chip"
                android:textColor="@color/accent_gold"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                android:contentDescription="@string/news_more_actions"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Headline -->
        <TextView
            android:id="@+id/tv_hero_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_lg"
            android:layout_marginTop="@dimen/space_sm"
            android:textSize="@dimen/text_body"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:textColor="@color/text_navy"
            android:lineHeight="22sp"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- Summary -->
        <TextView
            android:id="@+id/tv_hero_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_lg"
            android:layout_marginTop="@dimen/space_xs"
            android:layout_marginBottom="@dimen/space_lg"
            android:textSize="@dimen/text_secondary"
            android:textColor="@color/text_secondary"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
