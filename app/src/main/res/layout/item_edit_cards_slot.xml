<?xml version="1.0" encoding="utf-8"?>
<!-- Design branch 2a, direction 1d: one slot row. The handle drags to reorder
     within its category only; Swap opens a picker scoped to that same
     category so the card's label never goes stale. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_lg"
    android:layout_marginBottom="@dimen/space_sm"
    app:cardCornerRadius="@dimen/radius_card_kpi"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:paddingEnd="@dimen/space_md">

        <!-- TICKET-42: 48dp touch target via the same negative-margin trick as
             activity_main's btnSettings — the view overflows its old 40dp box
             by 4dp per side, so the glyph and the row's layout don't move.
             contentDescription is set in EditCardsBottomSheet (names the
             slot's indicator). -->
        <TextView
            android:id="@+id/dragHandleSlot"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="-4dp"
            android:gravity="center"
            android:text="@string/drag_handle_glyph"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/tvEditCardsSlotName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_navy"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <!-- TICKET-42: 48dp touch target — the view grows to 48dp inside the
             52dp row while bg_pill_swap_inset keeps the drawn pill at its old
             32dp height. contentDescription set in EditCardsBottomSheet. -->
        <TextView
            android:id="@+id/btnEditCardsSwap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingVertical="@dimen/space_xs"
            android:background="@drawable/bg_pill_swap_inset"
            android:text="@string/edit_cards_swap"
            android:textColor="@color/text_navy"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
