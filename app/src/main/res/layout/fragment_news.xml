<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- IOS-04 (2026-07-27 nav fix): this block owns News' topmost pixel,
             so it takes the header inset (NewsFragment.onCreateView). Before
             this, News was skipped by IOS-04 entirely — the subtitle and the
             filter chip row sat underneath the translucent header, with the
             chips half-occluded and their top half untappable. -->
        <LinearLayout
            android:id="@+id/newsHeaderBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_xs">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/news_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_secondary" />

            <TextView
                android:id="@+id/text_news_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <!-- Filter Chips Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingVertical="@dimen/space_sm"
            android:paddingHorizontal="@dimen/space_md">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:chipSpacingHorizontal="6dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_all"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    app:ensureMinTouchTargetSize="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All"
                    android:checked="true"
                    android:textColor="@color/news_chip_text_selector"
                    app:chipBackgroundColor="@color/news_chip_bg_selector"
                    app:chipStrokeColor="@color/news_chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="false"
                    app:chipIconVisible="false"
                    app:chipCornerRadius="20dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_fed"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    app:ensureMinTouchTargetSize="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fed"
                    android:textColor="@color/news_chip_text_selector"
                    app:chipBackgroundColor="@color/news_chip_bg_selector"
                    app:chipStrokeColor="@color/news_chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="false"
                    app:chipIconVisible="false"
                    app:chipCornerRadius="20dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_inflation"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    app:ensureMinTouchTargetSize="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inflation"
                    android:textColor="@color/news_chip_text_selector"
                    app:chipBackgroundColor="@color/news_chip_bg_selector"
                    app:chipStrokeColor="@color/news_chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="false"
                    app:chipIconVisible="false"
                    app:chipCornerRadius="20dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_jobs"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    app:ensureMinTouchTargetSize="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jobs"
                    android:textColor="@color/news_chip_text_selector"
                    app:chipBackgroundColor="@color/news_chip_bg_selector"
                    app:chipStrokeColor="@color/news_chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="false"
                    app:chipIconVisible="false"
                    app:chipCornerRadius="20dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_yields"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    app:ensureMinTouchTargetSize="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yields"
                    android:textColor="@color/news_chip_text_selector"
                    app:chipBackgroundColor="@color/news_chip_bg_selector"
                    app:chipStrokeColor="@color/news_chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="false"
                    app:chipIconVisible="false"
                    app:chipCornerRadius="20dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_economy"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    app:ensureMinTouchTargetSize="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Economy"
                    android:textColor="@color/news_chip_text_selector"
                    app:chipBackgroundColor="@color/news_chip_bg_selector"
                    app:chipStrokeColor="@color/news_chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="false"
                    app:chipIconVisible="false"
                    app:chipCornerRadius="20dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_research"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    app:ensureMinTouchTargetSize="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Research"
                    android:textColor="@color/news_chip_text_selector"
                    app:chipBackgroundColor="@color/news_chip_bg_selector"
                    app:chipStrokeColor="@color/news_chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="false"
                    app:chipIconVisible="false"
                    app:chipCornerRadius="20dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_housing"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    app:ensureMinTouchTargetSize="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Housing"
                    android:textColor="@color/news_chip_text_selector"
                    app:chipBackgroundColor="@color/news_chip_bg_selector"
                    app:chipStrokeColor="@color/news_chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="false"
                    app:chipIconVisible="false"
                    app:chipCornerRadius="20dp" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Content area: SwipeRefresh wraps RecyclerView; Progress and Error overlay -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe_refresh_news"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_news"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="@dimen/space_sm" />

            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <!-- P6 TICKET-36: list-shaped shimmer replaces the old ProgressBar +
                 loading text on first load, matching every other data screen. -->
            <include
                android:id="@+id/skeleton_news"
                layout="@layout/view_news_skeleton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/empty_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/space_2xl"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/text_display"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/news_empty_title"
                    android:textColor="@color/text_navy"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/news_empty_subtitle"
                    android:textAlignment="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_secondary" />

                <Button
                    android:id="@+id/btn_news_clear_filter"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:minHeight="48dp"
                    android:text="@string/news_clear_filter"
                    android:textColor="@color/text_navy"
                    app:strokeColor="@color/accent" />
            </LinearLayout>

            <!-- Error state: icon + message + retry -->
            <LinearLayout
                android:id="@+id/error_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/space_2xl"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠"
                    android:textSize="@dimen/text_display"
                    android:textColor="@color/accent"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="Couldn\'t load the news feed"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold"
                    android:textColor="@color/text_navy" />

                <TextView
                    android:id="@+id/text_news_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textSize="@dimen/text_secondary"
                    android:textColor="@color/text_secondary"
                    android:textAlignment="center" />

                <Button
                    android:id="@+id/btn_news_retry"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:minHeight="48dp"
                    android:text="Retry"
                    android:textColor="@color/text_navy"
                    app:strokeColor="@color/accent" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
