<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:paddingHorizontal="@dimen/space_md"
    android:paddingVertical="@dimen/space_sm"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvIndicatorRowLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/ink"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <!-- TICKET-42: decorative — the row's contentDescription (set in
         IndicatorPickerBottomSheet) already announces the selected state.
         Pantrii port U11: ink, not signal_good — a green ✓ is the HEALTHY
         badge glyph, and this tick only means "picked". -->
    <TextView
        android:id="@+id/tvIndicatorRowCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/check_glyph"
        android:textColor="@color/ink"
        android:textSize="@dimen/text_title"
        android:importantForAccessibility="no"
        android:visibility="invisible" />

</LinearLayout>
