<?xml version="1.0" encoding="utf-8"?>
<!-- Shared chrome for metric-detail bottom sheets: drag handle + scrolling content slot.
     Pantrii port U11: surface, 28dp top corners, the 40x4dp line handle every
     sheet shares (bg_sheet_handle).
     Root must be match_parent: BottomSheetBehavior#setFitToContents(false) positions this
     view's top edge by offset and expects it to span the parent; a wrap_content root leaves
     the sheet's bottom floating mid-screen or clips content off the bottom edge. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_rounded">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="@dimen/space_xs"
        android:background="@drawable/bg_sheet_handle"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sheetScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <FrameLayout
            android:id="@+id/sheetContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
