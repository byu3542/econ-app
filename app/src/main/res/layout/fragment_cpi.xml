<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm_off_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <!-- TICKET-18: per-screen retry chip (hidden until this screen's fetch fails) -->
        <include layout="@layout/view_retry_chip" />

        <!-- YoY INFLATION CARD — R2-TICKET-04 family A (12dp / 4dp / card_navy_badge),
             the same chrome as the Overview grid card for this metric.
             R2-TICKET-07: the overline was "Inflation (YoY % Change)" at 15sp and
             not actually all-caps; it is now a short 11sp overline with the
             qualifier moved to the description line under the badge. -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardCpiYoY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2xl"
            app:cardCornerRadius="@dimen/radius_card_kpi"
            app:cardElevation="@dimen/elevation_card_kpi"
            app:cardBackgroundColor="@color/card_navy_badge">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_2xl"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvCpiYoYLabel"
                    style="@style/Card.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CPI YOY" />

                <TextView
                    android:id="@+id/tvCpiYoYValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/card_white"
                    android:textSize="@dimen/text_display_xl"
                    android:fontFamily="serif"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/space_sm"/>

                <include
                    android:id="@+id/statusCpiYoY"
                    layout="@layout/view_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs" />

                <!-- R2-TICKET-07: the qualifier that used to live inside the overline
                     ("Inflation (YoY % Change)"). tvCpiYoYDate below is hidden at
                     runtime, so this needs its own always-visible line. -->
                <TextView
                    android:id="@+id/tvCpiYoYDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inflation, annualized % change"
                    android:textColor="@color/slate_dim"
                    android:textSize="@dimen/text_caption"
                    android:layout_marginTop="@dimen/space_hairline"/>

                <TextView
                    android:id="@+id/tvCpiYoYDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/slate_dim"
                    android:textSize="@dimen/text_caption"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TICKET-20: inline range switcher — drives both CPI charts -->
        <include layout="@layout/view_timeframe_selector" />

        <!-- CPI-U SECTION -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2xl"
            app:cardCornerRadius="@dimen/radius_card_panel"
            app:cardElevation="@dimen/elevation_card_panel"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/header_navy"
                    android:paddingHorizontal="@dimen/space_xl"
                    android:paddingVertical="@dimen/space_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consumer Price Index (CPI-U)"
                        android:textColor="@color/card_white"
                        android:textSize="@dimen/text_headline"
                        android:fontFamily="serif"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_alignParentBottom="true"
                        android:background="@color/accent_gold" />
                </RelativeLayout>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/cpiUChart"
                    android:importantForAccessibility="yes"
                    android:contentDescription="CPI-U inflation trend chart"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:padding="@dimen/space_lg"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CPI-W SECTION -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2xl"
            app:cardCornerRadius="@dimen/radius_card_panel"
            app:cardElevation="@dimen/elevation_card_panel"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/header_navy"
                    android:paddingHorizontal="@dimen/space_xl"
                    android:paddingVertical="@dimen/space_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CPI-W All Items"
                        android:textColor="@color/card_white"
                        android:textSize="@dimen/text_headline"
                        android:fontFamily="serif"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_alignParentBottom="true"
                        android:background="@color/accent_gold" />
                </RelativeLayout>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/cpiWChart"
                    android:importantForAccessibility="yes"
                    android:contentDescription="CPI-W inflation trend chart"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:padding="@dimen/space_lg"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
