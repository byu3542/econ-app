<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm_off_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <!-- TICKET-18: per-screen retry chip (hidden until this screen's fetch fails) -->
        <include layout="@layout/view_retry_chip" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_lg"
            android:baselineAligned="false">

            <!-- R2-TICKET-05: 4Q rolling average and latest quarter are two readings
                 of the same series, so they share one value size and colour. The
                 rolling average leads by position, not by type size. -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardGdpStatus"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="@dimen/space_xs"
                app:cardCornerRadius="@dimen/radius_card_kpi" app:cardElevation="@dimen/elevation_card_kpi"
                app:cardBackgroundColor="@color/card_navy_badge">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/space_lg" android:gravity="center">
                    <TextView style="@style/Card.Overline" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="4Q ROLLING AVG" />
                    <TextView android:id="@+id/tvGdpLatest" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="&#8212;"
                        android:textColor="@color/card_white" android:textSize="@dimen/text_display_lg" android:textStyle="bold" android:layout_marginTop="@dimen/space_xs" />
                    <include
                        android:id="@+id/statusGdp"
                        layout="@layout/view_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs" />
                    <TextView android:id="@+id/tvGdpDesc" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Annualized % change"
                        android:textColor="@color/slate_dim" android:textSize="@dimen/text_caption" android:layout_marginTop="@dimen/space_hairline" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardGdpLatestQuarter"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="@dimen/space_xs"
                app:cardCornerRadius="@dimen/radius_card_kpi" app:cardElevation="@dimen/elevation_card_kpi"
                app:cardBackgroundColor="@color/card_navy_badge">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/space_lg" android:gravity="center">
                    <TextView style="@style/Card.Overline" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="LATEST QUARTER" />
                    <TextView android:id="@+id/tvGdpLatestQuarterValue" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="&#8212;"
                        android:textColor="@color/card_white" android:textSize="@dimen/text_display_lg" android:textStyle="bold" android:layout_marginTop="@dimen/space_xs" />
                    <include
                        android:id="@+id/statusGdpLatestQuarter"
                        layout="@layout/view_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs" />
                    <TextView android:id="@+id/tvGdpLatestQuarterLabel" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text=""
                        android:textColor="@color/slate_dim" android:textSize="@dimen/text_caption" android:layout_marginTop="@dimen/space_hairline" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- TICKET-11: inline range switcher for the GDP chart -->
        <include layout="@layout/view_timeframe_selector" />

        <!-- Chart/panel card — R2-TICKET-04 family B (16dp / 6dp) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2xl" app:cardCornerRadius="@dimen/radius_card_panel"
            app:cardElevation="@dimen/elevation_card_panel" app:cardBackgroundColor="@color/header_navy">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingHorizontal="@dimen/space_xl" android:paddingTop="@dimen/space_lg">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="GDP Growth (Quarterly)" android:textColor="@color/card_white"
                        android:textSize="@dimen/text_body" android:fontFamily="serif" android:textStyle="bold" />
                    <View android:layout_width="match_parent" android:layout_height="2dp"
                        android:layout_marginTop="@dimen/space_sm" android:background="@color/accent_gold" />
                </LinearLayout>
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/gdpChart"
                    android:importantForAccessibility="yes"
                    android:contentDescription="GDP growth trend chart, quarterly"
                    android:layout_width="match_parent" android:layout_height="300dp" android:padding="@dimen/space_md" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
