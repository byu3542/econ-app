<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm_off_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <!-- TICKET-18: per-screen retry chip (hidden until this screen's fetch fails) -->
        <include layout="@layout/view_retry_chip" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="@dimen/space_lg">

            <!-- TICKET-21 / R2-TICKET-05: 10Y-3M is the screen hero and says so by
                 being ordered first. Both cards read the same concept (a curve
                 spread) and carry the same badge, so they share one value size and
                 colour — demoting the sibling made it look stale, not secondary. -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSpread3M"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_sm"
                app:cardCornerRadius="@dimen/radius_card_kpi"
                app:cardElevation="@dimen/elevation_card_kpi"
                app:cardBackgroundColor="@color/card_navy_badge">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/space_lg" android:gravity="center">
                    <TextView style="@style/Card.Overline" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="10Y-3M SPREAD" />
                    <com.economic.dashboard.ui.views.RollingNumberView android:id="@+id/tvSpread3MValue" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="&#8212;" android:textSize="@dimen/text_display_lg"
                        android:textColor="@color/card_white" android:textStyle="bold" android:layout_marginTop="@dimen/space_xs" />
                    <include
                        android:id="@+id/statusSpread3M"
                        layout="@layout/view_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardSpreadYoY"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_sm"
                app:cardCornerRadius="@dimen/radius_card_kpi"
                app:cardElevation="@dimen/elevation_card_kpi"
                app:cardBackgroundColor="@color/card_navy_badge">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/space_lg" android:gravity="center">
                    <TextView style="@style/Card.Overline" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="10Y-2Y SPREAD" />
                    <com.economic.dashboard.ui.views.RollingNumberView android:id="@+id/tvSpreadValue" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="&#8212;" android:textSize="@dimen/text_display_lg"
                        android:textColor="@color/card_white" android:textStyle="bold" android:layout_marginTop="@dimen/space_xs" />
                    <include
                        android:id="@+id/statusSpread2Y"
                        layout="@layout/view_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- TICKET-11: inline range switcher -->
        <include layout="@layout/view_timeframe_selector" />

        <!-- Chart/panel card — R2-TICKET-04 family B (16dp / 6dp) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2xl"
            app:cardCornerRadius="@dimen/radius_card_panel"
            app:cardElevation="@dimen/elevation_card_panel"
            app:cardBackgroundColor="@color/header_navy">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingHorizontal="@dimen/space_xl" android:paddingTop="@dimen/space_lg">
                    <TextView android:id="@+id/tvChartTitle" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="10Y-2Y Spread"
                        android:textAppearance="@style/TextAppearance.Econ.PanelTitle" />
                    <View android:layout_width="match_parent" android:layout_height="2dp"
                        android:layout_marginTop="@dimen/space_sm" android:background="@color/accent_gold" />
                </LinearLayout>
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/swappableChart"
                    android:importantForAccessibility="yes"
                    android:contentDescription="Yield spread trend chart"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:padding="@dimen/space_md" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
