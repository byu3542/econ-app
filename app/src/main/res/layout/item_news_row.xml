<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_md"
    android:layout_marginVertical="@dimen/space_xs"
    app:cardBackgroundColor="@color/surface_card"
    app:cardElevation="1dp"
    app:cardCornerRadius="10dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <!-- Impact bar on left edge (description set in adapter for TalkBack) -->
        <View
            android:id="@+id/view_impact_bar"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/space_md" />

        <!-- Content column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Source + time row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- TICKET-43: neutral, not gold — a gold label repeated on every
                     row of the feed breaks the 10% accent budget; only the hero
                     card's source keeps gold. TICKET-44: text_secondary, not
                     text_slate — this label sits on the theme-flipping
                     surface_card, and slate only clears 4.5:1 on the navy badge
                     surfaces it was made for. -->
                <TextView
                    android:id="@+id/tv_row_source"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tv_row_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/text_muted" />

            </LinearLayout>

            <!-- Headline -->
            <TextView
                android:id="@+id/tv_row_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textSize="@dimen/text_secondary"
                android:textColor="@color/text_navy"
                android:lineHeight="18sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_row_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/space_sm"
                    android:paddingVertical="@dimen/space_hairline"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/tv_row_impact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:textColor="@color/gold_ink"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>

        <!-- Optional thumbnail (only when the feed provides one) -->
        <ImageView
            android:id="@+id/iv_row_thumb"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/space_md"
            android:layout_gravity="center_vertical"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <!-- TICKET-59: was a circled-chevron ImageButton (reads "expand"); now a
             labelled chip with the analyst's sparkle. Same id, same target
             (NewsAdapter.showAnalyzeMenu). -->
        <TextView
            android:id="@+id/btn_row_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/space_sm"
            android:paddingHorizontal="@dimen/space_md"
            android:background="@drawable/bg_pill_navy"
            android:drawableStart="@drawable/ic_sparkle_12"
            android:drawableTint="@color/accent_gold"
            android:drawablePadding="@dimen/space_xs"
            android:text="@string/news_analyze_chip"
            android:textColor="@color/accent_gold"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:contentDescription="@string/news_more_actions"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
