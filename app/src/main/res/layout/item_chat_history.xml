<?xml version="1.0" encoding="utf-8"?>
<!-- Pantrii port U8 (R7, R10): one archived conversation. Same card as the
     start-screen prompt cards (bg_prompt_card: surface, hairline line, 20dp
     radius, no elevation). Title is the first question; the meta line is the
     date and message count. Tap reopens, swipe deletes with Undo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_sm"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_prompt_card"
    android:paddingStart="@dimen/space_xl"
    android:paddingEnd="@dimen/space_lg"
    android:paddingVertical="@dimen/space_md"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHistoryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Econ.Body"
            android:textColor="@color/ink"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvHistoryMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Econ.Caption"
            android:textColor="@color/muted"
            android:maxLines="1" />

    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="@dimen/space_md"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/muted"
        android:importantForAccessibility="no" />

</LinearLayout>
