<?xml version="1.0" encoding="utf-8"?>
<!-- Design branch 2a, direction 1d: category block header. Draggable via the
     handle to reorder the whole category block (moves its slots with it). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/space_md"
    android:paddingEnd="@dimen/space_lg"
    android:paddingTop="@dimen/space_md"
    android:paddingBottom="@dimen/space_xs">

    <!-- TICKET-42: 48dp touch target via the same negative-margin trick as
         activity_main's btnSettings — the view overflows its old 32dp box by
         8dp per side (mostly into the row's own padding; 4dp clips past the
         bottom edge), so the glyph and the row's layout don't move.
         contentDescription is set in EditCardsBottomSheet (names the
         category). -->
    <TextView
        android:id="@+id/dragHandleHeader"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="-8dp"
        android:gravity="center"
        android:text="@string/drag_handle_glyph"
        android:textColor="@color/muted"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/tvEditCardsHeaderTitle"
        style="@style/MetricGroupHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginBottom="0dp"
        android:layout_marginStart="@dimen/space_xs" />

</LinearLayout>
