<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════════════
     THE reference KPI/badge card (R2-TICKET-04). Dark navy, 12dp radius, 4dp
     elevation, @color/card_navy_badge.

     There are exactly two card families in this app and they are told apart by
     ROLE, not by screen:

       KPI / badge card  → @dimen/radius_card_kpi (12dp) + @dimen/elevation_card_kpi
                           (4dp) + @color/card_navy_badge. Any card carrying a
                           status badge. This file and the Overview grid define it;
                           every leaf tab's reading cards now match it, so the
                           Overview card and the leaf tab for the same metric are
                           finally the same object.
       Chart / panel card → @dimen/radius_card_panel (16dp) + @dimen/elevation_card_panel
                           (6dp). Charts and section panels only — never a badge.

     Before R2-TICKET-04 these were split arbitrarily (GDP was family A, Spreads
     one tab away was family B, Housing inverted both), which is what the
     Spreads-vs-GDP screenshots were actually showing.

     Used by Overview for the KPI indicator grid. Tappable (ripple foreground);
     shows value + delta chip + sparkline.
     ═══════════════════════════════════════════════════════════════════════════ -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@null"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/radius_card_kpi"
    app:cardElevation="@dimen/elevation_card_kpi"
    app:cardBackgroundColor="@color/card_navy_badge">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg"
        android:gravity="center">

        <!-- Label: indicator name (gold, all-caps) — R2-TICKET-07 -->
        <TextView
            android:id="@+id/tvMetricLabel"
            style="@style/Card.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="METRIC" />

        <!-- Value + delta vs. previous release -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/space_xs">

            <TextView
                android:id="@+id/tvMetricValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/card_white"
                android:textSize="@dimen/text_display"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMetricDelta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Sparkline: recent trend from local history -->
        <com.economic.dashboard.views.SparklineView
            android:id="@+id/sparkline"
            android:layout_width="90dp"
            android:layout_height="20dp"
            android:layout_marginTop="@dimen/space_sm"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <!-- Status row: colored dot + status word (R2-TICKET-03) -->
        <include
            android:id="@+id/statusBadge"
            layout="@layout/view_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm" />

        <!-- Sub-label: date -->
        <TextView
            android:id="@+id/tvMetricDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_slate"
            android:textSize="@dimen/text_caption"
            android:layout_marginTop="@dimen/space_hairline" />

        <!-- Sub-label: historical percentile (when available) -->
        <TextView
            android:id="@+id/tvPercentile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_slate"
            android:textSize="@dimen/text_caption" />

        <!-- Partial-failure affordance: shown only when this series failed to
             refresh. The cached value above stays visible; tapping re-fetches
             just this metric. -->
        <TextView
            android:id="@+id/tvRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:paddingHorizontal="@dimen/space_sm"
            android:paddingVertical="@dimen/space_xs"
            android:background="@drawable/bg_retry_pill"
            android:text="@string/couldnt_refresh"
            android:textColor="@color/signal_watch"
            android:textSize="@dimen/text_caption"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
