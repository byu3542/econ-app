<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════════════
     The Overview KPI card. Pantrii port U10 (R10): every card in the tabs is
     ONE card, @style/Widget.Econ.Card (20dp radius, no elevation, a 1dp line
     hairline on surface). The R2-TICKET-04 split into a navy KPI family
     (12dp/4dp) and a panel family (16dp/6dp), and the unused navy and gold
     light variants, are gone. A card that drives a chart marks itself with
     BenchmarkStyle.setCardActive (accent stroke), never a different card.

     Tappable (ripple); shows value + delta chip + sparkline + status badge.
     ═══════════════════════════════════════════════════════════════════════════ -->
<com.google.android.material.card.MaterialCardView
    style="@style/Widget.Econ.Card"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg"
        android:gravity="center">

        <!-- TICKET-58: every row below is a fixed-height slot (label: two caption
             lines; value: kpi_value_height; sparkline: 20dp; badge and date keep
             their intrinsic height and go INVISIBLE, never GONE) so two cards in
             a pair always put their value on the same baseline. -->

        <!-- Label: indicator name (muted overline, all-caps) — R2-TICKET-07, U10 -->
        <TextView
            android:id="@+id/tvMetricLabel"
            style="@style/Card.Overline"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/kpi_label_height"
            android:gravity="bottom|center_horizontal"
            android:maxLines="2"
            android:text="METRIC" />

        <!-- Value + delta vs. previous release -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/kpi_value_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/space_xs">

            <!-- MOT-01: rolling figures -->
            <com.economic.dashboard.ui.views.RollingNumberView
                android:id="@+id/tvMetricValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_display"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMetricDelta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Sparkline: recent trend from local history -->
        <com.economic.dashboard.views.SparklineView
            android:id="@+id/sparkline"
            android:layout_width="90dp"
            android:layout_height="20dp"
            android:layout_marginTop="@dimen/space_sm"
            android:visibility="invisible"
            android:importantForAccessibility="no" />

        <!-- Status row: colored dot + status word (R2-TICKET-03) -->
        <include
            android:id="@+id/statusBadge"
            layout="@layout/view_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm" />

        <!-- Sub-label: date -->
        <TextView
            android:id="@+id/tvMetricDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:lines="1"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_caption"
            android:layout_marginTop="@dimen/space_hairline" />

        <!-- Partial-failure affordance: shown only when this series failed to
             refresh. The cached value above stays visible; tapping re-fetches
             just this metric. -->
        <TextView
            android:id="@+id/tvRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:paddingHorizontal="@dimen/space_sm"
            android:paddingVertical="@dimen/space_xs"
            android:background="@drawable/bg_retry_pill"
            android:text="@string/couldnt_refresh"
            android:textColor="@color/ink_2"
            android:textSize="@dimen/text_caption"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
