<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm_off_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <!-- TICKET-18: per-screen retry chip (hidden until this screen's fetch fails) -->
        <include layout="@layout/view_retry_chip" />

        <!-- ═══════════════════════════════════════════════════════════════════
             HOUSING METRIC BADGES — Housing Starts & Existing Home Sales

             R2-TICKET-04: these were the family-A geometry (12dp/4dp) over the
             family-B colour (header_navy) — a third hybrid. Now fully family A.
             R2-TICKET-05/06: values were @dimen/text_secondary (13sp), the
             smallest KPI value in the app; now @dimen/text_display_lg like the
             rest, auto-shrinking only if a reading is too wide for its card.
             ═══════════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_lg"
            android:baselineAligned="false">

            <!-- HOUSING STARTS Badge -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_sm"
                app:cardCornerRadius="@dimen/radius_card_kpi"
                app:cardElevation="@dimen/elevation_card_kpi"
                app:cardBackgroundColor="@color/card_navy_badge">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md"
                    android:gravity="center">

                    <TextView
                        style="@style/Card.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOUSING STARTS" />

                    <TextView
                        android:id="@+id/tvStartsValue"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/kpi_value_height"
                        android:text="\u2014"
                        android:gravity="center"
                        android:textColor="@color/card_white"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="@dimen/text_kpi_autosize_min"
                        android:autoSizeMaxTextSize="@dimen/text_display_lg"
                        android:autoSizeStepGranularity="1sp"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/space_hairline" />

                    <include
                        android:id="@+id/statusStarts"
                        layout="@layout/view_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_hairline" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- HOME SALES Badge -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_sm"
                app:cardCornerRadius="@dimen/radius_card_kpi"
                app:cardElevation="@dimen/elevation_card_kpi"
                app:cardBackgroundColor="@color/card_navy_badge">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md"
                    android:gravity="center">

                    <TextView
                        style="@style/Card.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOME SALES" />

                    <TextView
                        android:id="@+id/tvSalesValue"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/kpi_value_height"
                        android:text="\u2014"
                        android:gravity="center"
                        android:textColor="@color/card_white"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="@dimen/text_kpi_autosize_min"
                        android:autoSizeMaxTextSize="@dimen/text_display_lg"
                        android:autoSizeStepGranularity="1sp"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/space_hairline" />

                    <include
                        android:id="@+id/statusSales"
                        layout="@layout/view_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_hairline" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════════════
             RATES BADGE ROW — Tappable badges for 30-Yr Rate, 10Y Treasury, Spread
             ═══════════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_lg"
            android:baselineAligned="false">

            <!-- 30-YR RATE Badge -->
            <androidx.cardview.widget.CardView
                android:id="@+id/badgeMortgage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_sm"
                app:cardCornerRadius="@dimen/radius_card_kpi"
                app:cardElevation="@dimen/elevation_card_kpi"
                app:cardBackgroundColor="@color/card_navy_badge">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md"
                    android:gravity="center">

                    <TextView
                        style="@style/Card.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30-YR RATE" />

                    <!-- R2-TICKET-05: all three rate cards read the same concept, so
                         they share one value size and colour. -->
                    <TextView
                        android:id="@+id/tvBadgeMortgageValue"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/kpi_value_height"
                        android:text="\u2014"
                        android:gravity="center"
                        android:textColor="@color/card_white"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="@dimen/text_kpi_autosize_min"
                        android:autoSizeMaxTextSize="@dimen/text_display_lg"
                        android:autoSizeStepGranularity="1sp"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/space_hairline" />

                    <include
                        android:id="@+id/statusMortgage"
                        layout="@layout/view_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_hairline" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 10Y T-RATE Badge -->
            <androidx.cardview.widget.CardView
                android:id="@+id/badge10Y"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/space_xs"
                app:cardCornerRadius="@dimen/radius_card_kpi"
                app:cardElevation="@dimen/elevation_card_kpi"
                app:cardBackgroundColor="@color/card_navy_badge">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md"
                    android:gravity="center">

                    <TextView
                        style="@style/Card.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10Y T-RATE" />

                    <TextView
                        android:id="@+id/tvBadge10YValue"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/kpi_value_height"
                        android:text="\u2014"
                        android:gravity="center"
                        android:textColor="@color/card_white"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="@dimen/text_kpi_autosize_min"
                        android:autoSizeMaxTextSize="@dimen/text_display_lg"
                        android:autoSizeStepGranularity="1sp"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/space_hairline" />

                    <include
                        android:id="@+id/status10Y"
                        layout="@layout/view_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_hairline" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SPREAD Badge -->
            <androidx.cardview.widget.CardView
                android:id="@+id/badgeSpread"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_sm"
                app:cardCornerRadius="@dimen/radius_card_kpi"
                app:cardElevation="@dimen/elevation_card_kpi"
                app:cardBackgroundColor="@color/card_navy_badge">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md"
                    android:gravity="center">

                    <TextView
                        style="@style/Card.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SPREAD" />

                    <TextView
                        android:id="@+id/tvBadgeSpreadValue"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/kpi_value_height"
                        android:text="\u2014"
                        android:gravity="center"
                        android:textColor="@color/card_white"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="@dimen/text_kpi_autosize_min"
                        android:autoSizeMaxTextSize="@dimen/text_display_lg"
                        android:autoSizeStepGranularity="1sp"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/space_hairline" />

                    <include
                        android:id="@+id/statusHousingSpread"
                        layout="@layout/view_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_hairline" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════════════
             SWAPPABLE CHART — Changes based on selected badge
             ═══════════════════════════════════════════════════════════════════ -->
        <!-- TICKET-11: inline range switcher (drives both Housing charts) -->
        <include layout="@layout/view_timeframe_selector" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2xl"
            app:cardCornerRadius="@dimen/radius_card_panel"
            app:cardElevation="@dimen/elevation_card_panel"
            app:cardBackgroundColor="@color/header_navy">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/card_navy_badge"
                    android:paddingHorizontal="@dimen/space_xl"
                    android:paddingVertical="@dimen/space_lg">

                    <TextView
                        android:id="@+id/tvSwappableTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30-Year Mortgage Rate (%)"
                        android:textColor="@color/info_blue_tint"
                        android:textSize="@dimen/text_body"
                        android:fontFamily="serif"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_alignParentBottom="true"
                        android:background="@color/accent_gold" />
                </RelativeLayout>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chartSwappable"
                    android:importantForAccessibility="yes"
                    android:contentDescription="Housing market trend chart"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:padding="@dimen/space_md" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ═══════════════════════════════════════════════════════════════════
             MBS & MORTGAGE RATES CHART
             ═══════════════════════════════════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2xl"
            app:cardCornerRadius="@dimen/radius_card_panel"
            app:cardElevation="@dimen/elevation_card_panel"
            app:cardBackgroundColor="@color/header_navy">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/card_navy_badge"
                    android:paddingHorizontal="@dimen/space_xl"
                    android:paddingVertical="@dimen/space_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MBS &amp; Mortgage Rates"
                        android:textColor="@color/info_blue_tint"
                        android:textSize="@dimen/text_body"
                        android:fontFamily="serif"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_alignParentBottom="true"
                        android:background="@color/accent_gold" />
                </RelativeLayout>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chartMbsMortgage"
                    android:importantForAccessibility="yes"
                    android:contentDescription="Mortgage rate and MBS spread chart"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:padding="@dimen/space_lg" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
