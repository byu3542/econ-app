<?xml version="1.0" encoding="utf-8"?>
<!-- TICKET-11 / IOS-05 / TICKET-55 — inline timeframe segmented control.
     One SegmentedView (four ≥48dp targets, recessed track, sliding gold
     thumb); tags carry the month window, which TimeframeSelector reads,
     persists per chart, and clamps to the series' cadence floor. -->
<com.economic.dashboard.ui.views.SegmentedView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/timeframeSelector"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    app:segmentLabels="@array/timeframe_segment_labels"
    app:segmentTags="@array/timeframe_segment_tags" />
