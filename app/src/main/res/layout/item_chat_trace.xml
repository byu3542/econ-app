<?xml version="1.0" encoding="utf-8"?>
<!-- MOT-02: analyst thinking trace. Included at the top of item_chat_message's
     bubble and shown only for a trace row (ChatMessage.isTrace). The shimmer is
     started/stopped by ChatAdapter from the stream state — never auto-started,
     never on a timer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/traceRow"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTraceChevron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_xs"
            android:text="▾"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_caption"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerTrace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:shimmer_auto_start="false">

            <TextView
                android:id="@+id/tvTraceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thinking"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_secondary" />
        </com.facebook.shimmer.ShimmerFrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llTraceSteps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>
