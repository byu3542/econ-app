<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm_off_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <!-- TICKET-18: per-screen retry chip (hidden until this screen's fetch fails) -->
        <include layout="@layout/view_retry_chip" />

        <!-- REAL WAGE GROWTH CARD — R2-TICKET-04 family A (12dp / 4dp / card_navy_badge).
             R2-TICKET-07: the overline was "Real Wage Growth v. Inflation (YOY %)"
             at 15sp and not actually all-caps; it is now a short 11sp overline with
             the qualifier moved to the description line under the badge. -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardWageYoY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2xl"
            app:cardCornerRadius="@dimen/radius_card_kpi"
            app:cardElevation="@dimen/elevation_card_kpi"
            app:cardBackgroundColor="@color/card_navy_badge">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_2xl"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvWageYoYLabel"
                    style="@style/Card.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REAL WAGE GROWTH"
                    android:textAlignment="center"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tvWageYoYValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/card_white"
                    android:textSize="@dimen/text_display_xl"
                    android:fontFamily="serif"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textAlignment="center"/>

                <include
                    android:id="@+id/statusWageYoY"
                    layout="@layout/view_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs" />

                <!-- R2-TICKET-07: the qualifier that used to live inside the overline.
                     tvWageYoYDate below stays hidden, so this needs its own line. -->
                <TextView
                    android:id="@+id/tvWageYoYDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wages vs. inflation, annualized % difference"
                    android:textColor="@color/slate_dim"
                    android:textSize="@dimen/text_caption"
                    android:layout_marginTop="@dimen/space_hairline"
                    android:textAlignment="center"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tvWageYoYDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/slate_dim"
                    android:textSize="@dimen/text_caption"
                    android:visibility="gone"
                    android:textAlignment="center"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TICKET-20: inline range switcher — drives both Wages charts -->
        <include layout="@layout/view_timeframe_selector" />

        <!-- AVERAGE HOURLY EARNINGS SECTION -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2xl"
            app:cardCornerRadius="@dimen/radius_card_panel"
            app:cardElevation="@dimen/elevation_card_panel"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/header_navy"
                    android:paddingHorizontal="@dimen/space_xl"
                    android:paddingVertical="@dimen/space_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Average Hourly Earnings"
                        android:textColor="@color/card_white"
                        android:textSize="@dimen/text_headline"
                        android:fontFamily="serif"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_alignParentBottom="true"
                        android:background="@color/accent_gold" />
                </RelativeLayout>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/hourlyWageChart"
                    android:importantForAccessibility="yes"
                    android:contentDescription="Average hourly earnings trend chart"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:padding="@dimen/space_lg"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- INFLATION VS WAGE GROWTH SECTION -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2xl"
            app:cardCornerRadius="@dimen/radius_card_panel"
            app:cardElevation="@dimen/elevation_card_panel"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/header_navy"
                    android:paddingHorizontal="@dimen/space_xl"
                    android:paddingVertical="@dimen/space_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inflation vs Wage Growth"
                        android:textColor="@color/card_white"
                        android:textSize="@dimen/text_headline"
                        android:fontFamily="serif"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_alignParentBottom="true"
                        android:background="@color/accent_gold" />
                </RelativeLayout>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/comparisonChart"
                    android:importantForAccessibility="yes"
                    android:contentDescription="Wages versus inflation comparison chart"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:padding="@dimen/space_lg"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
