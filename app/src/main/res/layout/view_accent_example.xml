<?xml version="1.0" encoding="utf-8"?>
<!-- Settings parity U4 (R5): the live Example card. Every accent surface
     reads ?attr/econAccent*; SettingsFragment.previewExample() overrides the
     tints for an instant preview before the Activity recreates. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:importantForAccessibility="noHideDescendants">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/exChipOn"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:background="@drawable/bg_pill_accent"
            android:text="@string/accent_example_chip_on"
            android:textStyle="bold"
            android:textSize="@dimen/text_body"
            android:textColor="?attr/econOnAccent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="@dimen/space_sm"
            android:gravity="center"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:background="@drawable/bg_settings_icon_tile"
            android:text="@string/accent_example_chip_off"
            android:textStyle="bold"
            android:textSize="@dimen/text_body"
            android:textColor="@color/ink"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/accent_example_progress"
            android:textSize="@dimen/text_secondary"
            android:textColor="@color/muted"/>

        <TextView
            android:id="@+id/exPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/accent_example_percent"
            android:textStyle="bold"
            android:textSize="@dimen/text_secondary"
            android:textColor="?attr/econAccent"/>
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/exProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:progress="68"
        app:trackThickness="6dp"
        app:trackCornerRadius="3dp"
        app:indicatorColor="?attr/econAccent"
        app:trackColor="@color/surface_2"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/accent_example_switch"
            android:textSize="@dimen/text_body"
            android:textColor="@color/ink"/>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/exSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:clickable="false"
            android:focusable="false"/>
    </LinearLayout>

    <TextView
        android:id="@+id/exButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center"
        android:background="@drawable/bg_pill_accent"
        android:text="@string/accent_example_button"
        android:textStyle="bold"
        android:textSize="@dimen/text_title"
        android:textColor="?attr/econOnAccent"/>
</LinearLayout>
