<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_xl"
        android:paddingVertical="@dimen/space_row_compact"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvMaturity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Label"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_body" />

        <!-- Direction vs. prior reading, same ▲/▼ glyph + color as the Overview badges -->
        <TextView
            android:id="@+id/tvChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_md"
            android:minWidth="52dp"
            android:gravity="end"
            android:text=""
            android:textStyle="bold"
            android:textSize="@dimen/text_caption"
            android:fontFeatureSettings="tnum" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvYield"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00%"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-02-24"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_caption"
                android:letterSpacing="0.05" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/space_xl"
        android:background="@color/line" />
</LinearLayout>
