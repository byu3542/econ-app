<?xml version="1.0" encoding="utf-8"?>
<!-- Animated launch splash. Picks up exactly where the system splash leaves
     off: same navy ground, same wordmark drawable at the same size and centre,
     so the handoff is invisible and only the motion starts. Driven by
     LaunchSplash. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_navy"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/splash_wordmark"
        android:layout_width="@dimen/splash_wordmark_size"
        android:layout_height="@dimen/splash_wordmark_size"
        android:layout_gravity="center"
        android:contentDescription="@string/app_name"
        android:src="@drawable/splash_wordmark_anim" />
</FrameLayout>
