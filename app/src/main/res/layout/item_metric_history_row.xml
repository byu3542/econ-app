<?xml version="1.0" encoding="utf-8"?>
<!-- One row in a metric popup's DATA → TABLE pane (mockup 1c). Generalized
     from item_fed_funds_history.xml so MetricHistoryAdapter can drive it for
     any of the 13 catalog indicators, not just Fed Funds. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/space_md"
        android:paddingHorizontal="@dimen/space_sm"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvHistoryDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/sheet_text_primary"
            android:textSize="@dimen/text_secondary" />

        <TextView
            android:id="@+id/tvHistoryValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/sheet_text_primary"
            android:textSize="@dimen/text_secondary"
            android:gravity="center"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHistoryChange"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/sheet_text_secondary"
            android:textSize="@dimen/text_secondary"
            android:gravity="end"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/sheet_divider" />

</LinearLayout>
