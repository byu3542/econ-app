<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-10-12 analyst cards T2: one table inside an analyst bubble, from a
     render_table call. Header: label + status pill; "Last 5 of N months";
     rows (month, value, change vs previous) newest first, built in
     ChatAdapter.applyTableCard. Tapping opens the metric sheet on Table. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chatTableCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_sm"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTableLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_navy"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/llTablePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <View
                android:id="@+id/viewTablePillDot"
                android:layout_width="@dimen/dot_pill"
                android:layout_height="@dimen/dot_pill"
                android:layout_marginEnd="@dimen/space_xs"
                android:background="@drawable/dot_neutral"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvTablePill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvTableCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_caption" />

    <LinearLayout
        android:id="@+id/llTableRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:orientation="vertical" />
</LinearLayout>
