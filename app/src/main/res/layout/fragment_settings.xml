<?xml version="1.0" encoding="utf-8"?>
<!-- Design 1b: Settings as a full-screen page, opened like any other tab.
     Two panes stacked in this FrameLayout, toggled by visibility:
       settingsListScroll   — grouped list of section rows with live summaries
       settingsDetailScroll — the tapped section's own controls (back row + title
                               + exactly one of the 8 cards below made visible)
     See SettingsFragment.kt for the show/hide + binding logic. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ══════════════════════ LIST PANE ══════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsListScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_3xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_search_field"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_md"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:src="@drawable/ic_search"
                    app:tint="@color/muted"
                    android:contentDescription="@null"/>

                <EditText
                    android:id="@+id/etSettingsSearch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/settings_search_hint"
                    android:textColorHint="@color/muted"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:maxLines="1"
                    android:singleLine="true"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvGroupPreferences"
                style="@style/SettingsSectionHeader"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/settings_group_preferences"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGroupPreferences"
                style="@style/SettingsCard"
                android:layout_marginTop="0dp">
                <LinearLayout
                    android:id="@+id/llGroupPreferences"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvGroupData"
                style="@style/SettingsSectionHeader"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/settings_group_data"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGroupData"
                style="@style/SettingsCard"
                android:layout_marginTop="0dp">
                <LinearLayout
                    android:id="@+id/llGroupData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvGroupSupport"
                style="@style/SettingsSectionHeader"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/settings_group_support"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGroupSupport"
                style="@style/SettingsCard"
                android:layout_marginTop="0dp">
                <LinearLayout
                    android:id="@+id/llGroupSupport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Settings parity U3 (R3): wordmark-and-version footer. -->
            <LinearLayout
                android:id="@+id/settingsFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/assistant_wordmark_brand"
                    android:fontFamily="@font/plus_jakarta_sans_extrabold"
                    app:fontFamily="@font/plus_jakarta_sans_extrabold"
                    android:textColor="?attr/econAccent"
                    android:textSize="22sp"
                    android:importantForAccessibility="no"/>

                <TextView
                    android:id="@+id/tvFooterVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="@dimen/text_secondary"
                    android:textColor="@color/muted"
                    tools:text="Version 1.0"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══════════════════════ DETAIL PANE ══════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsDetailScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_3xl">

            <!-- ~~ APPEARANCE ~~ -->
            <!-- Settings parity U4 (R5): Theme, Accent color, Example, Display. -->
            <LinearLayout
                android:id="@+id/appearancePage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/SettingsSectionHeader" android:text="@string/appearance_theme_header"/>
                <com.google.android.material.card.MaterialCardView style="@style/SettingsCard" android:layout_marginTop="0dp">
                    <LinearLayout
                        android:id="@+id/llThemeRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                </com.google.android.material.card.MaterialCardView>

                <TextView style="@style/SettingsSectionHeader" android:layout_marginTop="@dimen/space_lg" android:text="@string/appearance_accent_header"/>
                <com.google.android.material.card.MaterialCardView style="@style/SettingsCard" android:layout_marginTop="0dp">
                    <LinearLayout
                        android:id="@+id/llAccentSwatches"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                </com.google.android.material.card.MaterialCardView>

                <TextView style="@style/SettingsSectionHeader" android:layout_marginTop="@dimen/space_lg" android:text="@string/appearance_example_header"/>
                <com.google.android.material.card.MaterialCardView style="@style/SettingsCard" android:layout_marginTop="0dp">
                    <include android:id="@+id/accentExample" layout="@layout/view_accent_example"/>
                </com.google.android.material.card.MaterialCardView>

                <TextView style="@style/SettingsSectionHeader" android:layout_marginTop="@dimen/space_lg" android:text="@string/appearance_display_header"/>
                <com.google.android.material.card.MaterialCardView style="@style/SettingsCard" android:layout_marginTop="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <LinearLayout style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_colorblind"/>
                        <LinearLayout style="@style/SettingsRowText">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/colorblind_title"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/colorblind_sub"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/switchColorblind"
                            android:contentDescription="@string/colorblind_title"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="@dimen/divider_hairline_height"
                        android:background="@drawable/divider_hairline_inset"/>

                    <LinearLayout style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_haptics"/>
                        <LinearLayout style="@style/SettingsRowText">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/haptics_title"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/haptics_sub"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/switchHaptics"
                            android:contentDescription="@string/haptics_title"/>
                    </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ~~ STARTUP TAB ~~ -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardStartup" style="@style/SettingsCard" android:layout_marginTop="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout style="@style/SettingsInfoRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_startup"/>
                        <LinearLayout style="@style/SettingsRowText">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/startup_title"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/startup_sub"/>
                        </LinearLayout>
                    </LinearLayout>
                    <!-- TICKET-55: tags are the bottom-nav index SettingsManager stores -->
                    <com.economic.dashboard.ui.views.SegmentedView
                        android:id="@+id/segDefaultTab"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:segmentTextSize="@dimen/text_secondary"
                        app:segmentLabels="@array/startup_tab_segment_labels"
                        app:segmentTags="@array/startup_tab_segment_tags"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ~~ ECON ANALYST ~~ -->
            <LinearLayout
                android:id="@+id/aiPage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardAi" style="@style/SettingsCard" android:layout_marginTop="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_followups"/>
                        <LinearLayout style="@style/SettingsRowText">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/smart_chips"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/smart_chips_sub"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/switchSmartChips"
                            android:contentDescription="@string/smart_chips"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="@dimen/divider_hairline_height"
                        android:background="@drawable/divider_hairline_inset"/>

                    <LinearLayout style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_detailed"/>
                        <LinearLayout style="@style/SettingsRowText">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/detailed_ai"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/detailed_ai_sub"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/switchDetailedAi"
                            android:contentDescription="@string/detailed_ai"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Settings parity U5 (R4): destructive actions are red text rows at the page foot. -->
            <TextView
                android:id="@+id/btnClearChat"
                style="@style/SettingsDestructiveRow"
                android:text="@string/clear_chat_history"/>
            </LinearLayout>

            <!-- ~~ DATA & SYNC ~~ -->
            <LinearLayout
                android:id="@+id/dataPage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardData" style="@style/SettingsCard" android:layout_marginTop="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout android:id="@+id/rowRefreshNow" style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_refresh"/>
                        <LinearLayout style="@style/SettingsRowText">
                            <TextView android:id="@+id/tvRefreshTitle" style="@style/SettingsRowTitle" android:text="@string/refresh_now"/>
                            <TextView android:id="@+id/tvLastUpdated" style="@style/SettingsRowSub" android:text="@string/checking_freshness"/>
                        </LinearLayout>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="@dimen/divider_hairline_height"
                        android:background="@drawable/divider_hairline_inset"/>
                    <LinearLayout style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_settings_startup"/>
                        <LinearLayout style="@style/SettingsRowText">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/refresh_on_open"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/refresh_on_open_sub"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/switchRefreshOnOpen"
                            android:contentDescription="@string/refresh_on_open"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/SettingsRowSub"
                android:layout_marginTop="@dimen/space_sm"
                android:paddingStart="@dimen/space_sm"
                android:paddingEnd="@dimen/space_sm"
                android:text="@string/data_cache_sub"/>
            <TextView
                android:id="@+id/btnClearCache"
                style="@style/SettingsDestructiveRow"
                android:text="@string/clear_cache"/>
            </LinearLayout>

            <!-- ~~ NEWS SOURCES ~~ -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardNews" style="@style/SettingsCard" android:layout_marginTop="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNewsSourcesSummary"
                        style="@style/SettingsRowSub"
                        android:layout_marginBottom="@dimen/space_xs"/>

                    <LinearLayout style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_news_gov"/>
                        <LinearLayout style="@style/SettingsRowText">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/news_gov"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/news_gov_sub"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/switchNewsGov"
                            android:contentDescription="@string/news_gov"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="@dimen/divider_hairline_height"
                        android:background="@drawable/divider_hairline_inset"/>

                    <LinearLayout style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_news_media"/>
                        <LinearLayout style="@style/SettingsRowText">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/news_media"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/news_media_sub"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/switchNewsMedia"
                            android:contentDescription="@string/news_media"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="@dimen/divider_hairline_height"
                        android:background="@drawable/divider_hairline_inset"/>

                    <LinearLayout style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_news_intl"/>
                        <LinearLayout style="@style/SettingsRowText">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/news_intl"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/news_intl_sub"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/switchNewsIntl"
                            android:contentDescription="@string/news_intl"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="@dimen/divider_hairline_height"
                        android:background="@drawable/divider_hairline_inset"/>

                    <LinearLayout style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_news_research"/>
                        <LinearLayout style="@style/SettingsRowText">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/news_research"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/news_research_sub"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/switchNewsResearch"
                            android:contentDescription="@string/news_research"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ~~ CHARTS ~~ -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardCharts" style="@style/SettingsCard" android:layout_marginTop="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_gridlines"/>
                        <LinearLayout style="@style/SettingsRowText">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/gridlines"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/gridlines_sub"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/switchGridlines"
                            android:contentDescription="@string/gridlines"/>
                    </LinearLayout>

                    <LinearLayout style="@style/SettingsInfoRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_decimals"/>
                        <TextView style="@style/SettingsRowTitle" android:text="@string/axis_decimals"/>
                    </LinearLayout>

                    <!-- TICKET-55: tags are the decimal count -->
                    <com.economic.dashboard.ui.views.SegmentedView
                        android:id="@+id/segDecimals"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:segmentTextSize="@dimen/text_secondary"
                        app:segmentLabels="@array/decimals_segment_labels"
                        app:segmentTags="@array/decimals_segment_tags"/>

                    <LinearLayout style="@style/SettingsInfoRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_timeframe"/>
                        <TextView style="@style/SettingsRowTitle" android:text="@string/chart_timeframe"/>
                    </LinearLayout>

                    <!-- TICKET-55: tags are month windows (KEY_CHART_TIMEFRAME) -->
                    <com.economic.dashboard.ui.views.SegmentedView
                        android:id="@+id/segTimeframe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:segmentTextSize="@dimen/text_secondary"
                        app:segmentLabels="@array/timeframe_segment_labels"
                        app:segmentTags="@array/timeframe_segment_tags"/>

                    <TextView style="@style/SettingsRowSub"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/chart_apply_note"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ~~ NOTIFICATIONS ~~ -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardNotifications" style="@style/SettingsCard" android:layout_marginTop="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Settings parity U5 (R9): the permission status row. -->
                    <LinearLayout android:id="@+id/rowNotifStatus" style="@style/SettingsInfoRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_notify"/>
                        <LinearLayout style="@style/SettingsRowText">
                            <TextView android:id="@+id/tvNotifStatusTitle" style="@style/SettingsRowTitle"/>
                            <TextView android:id="@+id/tvNotifStatus" style="@style/SettingsRowSub"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/btnNotifAllow"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="@dimen/space_sm"
                            android:gravity="center"
                            android:paddingStart="@dimen/space_md"
                            android:paddingEnd="@dimen/space_md"
                            android:background="@drawable/bg_pill_accent"
                            android:text="@string/notif_allow"
                            android:textStyle="bold"
                            android:textSize="@dimen/text_body"
                            android:textColor="?attr/econOnAccent"
                            android:visibility="gone"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="@dimen/divider_hairline_height"
                        android:background="@drawable/divider_hairline_inset"/>

                    <LinearLayout style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_trending_up"/>
                        <LinearLayout style="@style/SettingsRowText">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/notify_moves"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/notify_moves_sub"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/switchNotifyMoves"
                            android:contentDescription="@string/notify_moves"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="@dimen/divider_hairline_height"
                        android:background="@drawable/divider_hairline_inset"/>

                    <LinearLayout style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_releases"/>
                        <LinearLayout style="@style/SettingsRowText">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/notify_releases"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/notify_releases_sub"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/switchNotifyReleases"
                            android:contentDescription="@string/notify_releases"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="@dimen/divider_hairline_height"
                        android:background="@drawable/divider_hairline_inset"/>

                    <LinearLayout style="@style/SettingsRow">
                        <ImageView style="@style/SettingsRowIcon" android:src="@drawable/ic_row_brief"/>
                        <LinearLayout style="@style/SettingsRowText">
                            <TextView style="@style/SettingsRowTitle" android:text="@string/daily_brief"/>
                            <TextView style="@style/SettingsRowSub" android:text="@string/daily_brief_sub"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/switchDailyBrief"
                            android:contentDescription="@string/daily_brief"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ~~ ABOUT ~~ -->
            <!-- ~~ DATA SOURCES & AI ~~ (settings parity U3, R3) -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardSources" style="@style/SettingsCard" android:layout_marginTop="0dp">
                <TextView
                    style="@style/SettingsRowSub"
                    android:text="@string/about_data_note"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/cardAbout" style="@style/SettingsCard" android:layout_marginTop="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvVersion"
                        style="@style/SettingsRowSub"
                        android:text="Economii"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══════════════════════ SHORTCUTS EDITOR ══════════════════════ -->
    <!-- Settings parity U7 (R11): its own pane, not a detail card, because the
         list scrolls under a sticky Save changes button. SettingsFragment
         shows it for the "shortcuts" section. -->
    <LinearLayout
        android:id="@+id/shortcutsEditorPane"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvShortcutsEditor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:paddingBottom="@dimen/space_lg" />

        <TextView
            android:id="@+id/btnShortcutsSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_marginEnd="@dimen/space_lg"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_md"
            android:minHeight="56dp"
            android:gravity="center"
            android:background="@drawable/bg_pill_accent"
            android:text="@string/shortcuts_editor_save"
            android:textColor="?attr/econOnAccent"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</FrameLayout>
