<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm_off_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <!-- TICKET-18: per-screen retry chip (hidden until this screen's fetch fails) -->
        <include layout="@layout/view_retry_chip" />

        <!-- R2-TICKET-06: Stocks used to run its own flatter ramp (22sp hero /
             18sp siblings) while the rest of the app used 34sp. All three values
             are now @dimen/text_display_lg like everywhere else; because three
             34sp values don't fit a 360dp row, they auto-shrink uniformly to
             @dimen/text_kpi_autosize_min rather than being hardcoded smaller.
             TICKET-58: the charted card is the row's hero — StocksFragment
             (HeroValue) caps the two siblings at text_display and moves the cap
             with the gold stroke; the 140dp minHeight is gone so cards size to
             their content. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="@dimen/space_lg">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Econ.Card"
                android:id="@+id/cardSp500"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_hairline">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/space_md" android:gravity="center">
                    <TextView style="@style/Card.Overline" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="S&amp;P 500" />
                    <com.economic.dashboard.ui.views.RollingNumberView android:id="@+id/tvSp500Value" android:layout_width="match_parent"
                        android:layout_height="@dimen/kpi_value_height" android:text="—" android:gravity="center"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="@dimen/text_kpi_autosize_min"
                        android:autoSizeMaxTextSize="@dimen/text_display_lg"
                        android:autoSizeStepGranularity="1sp"
                        android:textColor="@color/ink" android:textStyle="bold" android:layout_marginTop="@dimen/space_xs" />
                    <include
                        android:id="@+id/statusSp500"
                        layout="@layout/view_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Econ.Card"
                android:id="@+id/cardNasdaq"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_hairline"
                android:layout_marginEnd="@dimen/space_hairline">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/space_md" android:gravity="center">
                    <TextView style="@style/Card.Overline" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Nasdaq" />
                    <com.economic.dashboard.ui.views.RollingNumberView android:id="@+id/tvNasdaqValue" android:layout_width="match_parent"
                        android:layout_height="@dimen/kpi_value_height" android:text="—" android:gravity="center"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="@dimen/text_kpi_autosize_min"
                        android:autoSizeMaxTextSize="@dimen/text_display_lg"
                        android:autoSizeStepGranularity="1sp"
                        android:textColor="@color/ink" android:textStyle="bold" android:layout_marginTop="@dimen/space_xs" />
                    <include
                        android:id="@+id/statusNasdaq"
                        layout="@layout/view_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Econ.Card"
                android:id="@+id/cardVix"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_hairline">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/space_md" android:gravity="center">
                    <TextView style="@style/Card.Overline" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="VIX" />
                    <com.economic.dashboard.ui.views.RollingNumberView android:id="@+id/tvVixValue" android:layout_width="match_parent"
                        android:layout_height="@dimen/kpi_value_height" android:text="—" android:gravity="center"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="@dimen/text_kpi_autosize_min"
                        android:autoSizeMaxTextSize="@dimen/text_display_lg"
                        android:autoSizeStepGranularity="1sp"
                        android:textColor="@color/ink" android:textStyle="bold" android:layout_marginTop="@dimen/space_xs" />
                    <include
                        android:id="@+id/statusVix"
                        layout="@layout/view_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- TICKET-11: inline range switcher -->
        <include layout="@layout/view_timeframe_selector" />

        <!-- Chart/panel card — R2-TICKET-04 family B (16dp / 6dp) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Econ.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2xl">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingHorizontal="@dimen/space_xl" android:paddingTop="@dimen/space_lg">
                    <TextView android:id="@+id/tvChartTitle" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="S&amp;P 500 Index"
                        android:textAppearance="@style/TextAppearance.Econ.PanelTitle" />
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginTop="@dimen/space_sm" android:background="@color/line" />
                </LinearLayout>
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/swappableChart"
                    android:importantForAccessibility="yes"
                    android:contentDescription="Stock market trend chart"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:padding="@dimen/space_md" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
