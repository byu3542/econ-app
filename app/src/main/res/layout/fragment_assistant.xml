<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen AI economii Analyst (AssistantFragment, Pantrii port U3), pushed
  onto MainActivity's fragmentContainer. Root pads itself for system bars and
  the IME. Vertical LinearLayout so the chat area can flex.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ground"
    android:clickable="true"
    android:focusable="false">

    <!-- Pantrii port U3 (R1): back · wordmark · history · new chat. All
         buttons are 48dp touch targets drawn as 40dp rounded squares (inset
         backgrounds, butted together for an 8dp visible gap, matching Pantrii);
         icon buttons on surface_2, new chat
         is the one accent fill. Wordmark: brand in accent, role in ink. -->
    <LinearLayout
        android:id="@+id/rlHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingVertical="@dimen/space_sm">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_button_inset"
            android:src="@drawable/ic_chevron_left"
            android:contentDescription="@string/assistant_back"
            app:tint="@color/ink" />

        <!-- TICKET-P2-8: the wordmark is the identity marker's tap target —
             what is this / where do the numbers come from. -->
        <LinearLayout
            android:id="@+id/llAnalystIdentity"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/space_md"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/assistant_about">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/assistant_wordmark_brand"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                app:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:textColor="@color/accent"
                android:textSize="20sp"
                android:maxLines="1"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/assistant_wordmark_role"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                app:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:importantForAccessibility="no" />

        </LinearLayout>

        <!-- U8 (R7): opens ChatHistoryFragment. -->
        <ImageButton
            android:id="@+id/btnHistory"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_button_inset"
            android:src="@drawable/ic_history"
            android:contentDescription="@string/assistant_history"
            app:tint="@color/ink" />

        <ImageButton
            android:id="@+id/btnClearChat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_button_accent_inset"
            android:src="@drawable/ic_add"
            android:contentDescription="@string/assistant_new_chat"
            app:tint="@color/on_accent" />

    </LinearLayout>

    <!-- Quick-ask chip row -->
    <TextView
        android:id="@+id/tvAskAbout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ASK ABOUT"
        android:textColor="@color/muted"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginStart="@dimen/space_lg" />

    <HorizontalScrollView
        android:id="@+id/hsvChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm"
        android:clipToPadding="false"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg">

        <LinearLayout
            android:id="@+id/llChipRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipRecentNews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recent News"
                android:background="@drawable/bg_chip_outline"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingVertical="@dimen/space_sm"
                android:textSize="@dimen/text_secondary"
                android:textColor="@color/muted"
                android:layout_marginEnd="@dimen/space_sm"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipRecentUpdates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recent Economic Updates"
                android:background="@drawable/bg_chip_outline"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingVertical="@dimen/space_sm"
                android:textSize="@dimen/text_secondary"
                android:textColor="@color/muted"
                android:layout_marginEnd="@dimen/space_sm"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipYieldCurve"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yield curve health"
                android:background="@drawable/bg_chip_outline"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingVertical="@dimen/space_sm"
                android:textSize="@dimen/text_secondary"
                android:textColor="@color/muted"
                android:layout_marginEnd="@dimen/space_sm"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipRecession"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recession risk?"
                android:background="@drawable/bg_chip_outline"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingVertical="@dimen/space_sm"
                android:textSize="@dimen/text_secondary"
                android:textColor="@color/muted"
                android:layout_marginEnd="@dimen/space_sm"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipWages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Real wage trend"
                android:background="@drawable/bg_chip_outline"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingVertical="@dimen/space_sm"
                android:textSize="@dimen/text_secondary"
                android:textColor="@color/muted"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Chat messages + scroll-to-bottom pill -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/space_lg"
            android:clipToPadding="false"
            android:clipChildren="false" />

        <!-- Pantrii port U4 (R2): "How can I help?" start screen, shown until
             the first message is sent. Vertically centred in the thread area;
             scrolls when the window is too short (landscape, split screen). -->
        <ScrollView
            android:id="@+id/llEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="@color/ground"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="@dimen/space_xl"
                android:paddingVertical="@dimen/space_2xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/assistant_start_title"
                    android:textAppearance="@style/TextAppearance.Econ.Display"
                    android:textColor="@color/ink"
                    android:accessibilityHeading="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/assistant_start_subtitle"
                    android:textAppearance="@style/TextAppearance.Econ.Body"
                    android:textColor="@color/muted"
                    android:gravity="center" />

                <!-- U5: data-source line, moved here from under the composer. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/assistant_start_sources"
                    android:textAppearance="@style/TextAppearance.Econ.Caption"
                    android:textColor="@color/muted"
                    android:gravity="center" />

                <!-- Up to four prompt cards (item_prompt_card). Tap sends
                     (KTD7). Animated in centre-out (CentreOutStagger). -->
                <LinearLayout
                    android:id="@+id/llPromptCards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xl"
                    android:orientation="vertical"
                    android:showDividers="middle"
                    android:divider="@drawable/divider_prompt_card" />

            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/pillNewReply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/space_md"
            android:text="↓ New reply"
            android:textSize="@dimen/text_secondary"
            android:textColor="@color/ink"
            android:background="@drawable/bg_pill_sheet"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingVertical="@dimen/space_sm"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

    </FrameLayout>

    <!-- MOT-03: follow-up prompts under a finished answer (fill, never send).
         Pantrii port U6 (R6): one horizontally scrolling line of pills. The
         scroller has no padding of its own, so it collapses to nothing while
         cgFollowUps is GONE. -->
    <HorizontalScrollView
        android:id="@+id/hsvFollowUps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgFollowUps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_xs"
            android:visibility="gone"
            app:singleLine="true"
            app:chipSpacingHorizontal="@dimen/space_sm" />
    </HorizontalScrollView>

    <!-- Input area -->

    <!-- Pending image preview (vision analysis) -->
    <LinearLayout
        android:id="@+id/llImagePreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_sm"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivImagePreview"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:contentDescription="Attached image preview" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_md"
            android:text="Image attached — will be analyzed with your next message"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_caption" />

        <ImageButton
            android:id="@+id/btnRemoveImage"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/muted"
            android:contentDescription="Remove attached image" />

    </LinearLayout>

    <!-- Pantrii port U5 (R3, R12): composer row. Attach and send are 52dp
         rounded squares; the field carries a trailing mic for dictation. -->
    <LinearLayout
        android:id="@+id/llInputArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_lg">

        <ImageButton
            android:id="@+id/btnAttach"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_attach_image"
            android:background="@drawable/bg_composer_button"
            app:tint="@color/composer_button_icon"
            android:contentDescription="Attach an image for analysis" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/space_sm"
            android:background="@drawable/bg_composer_field"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_xs">

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="@dimen/space_md"
                android:hint="Ask me anything"
                android:background="@null"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:textAppearance="@style/TextAppearance.Econ.Body"
                android:inputType="textCapSentences"
                android:imeOptions="actionSend"
                android:maxLines="4" />

            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_mic"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/muted"
                android:contentDescription="Dictate a message"
                android:visibility="gone" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_send_filled"
            android:background="@drawable/bg_composer_button"
            app:tint="@color/composer_button_icon"
            android:contentDescription="Send message"
            android:enabled="false" />

    </LinearLayout>

</LinearLayout>
