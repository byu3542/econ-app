<?xml version="1.0" encoding="utf-8"?>
<!-- TICKET-43: the accent marks the CHECKED state only — a flat tint made every
     checkbox coloured whether picked or not, spending the accent on nothing.
     Pantrii port U11: accent, not the old gold literal (a checkbox is a
     control, KTD10 rule 1). Same state-gated pattern as switch_track_tint. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/econAccent" android:state_checked="true" />
    <item android:color="@color/muted" />
</selector>
