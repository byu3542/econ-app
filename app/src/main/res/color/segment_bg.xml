<?xml version="1.0" encoding="utf-8"?>
<!-- TICKET-55 step 1: fill for single-select segments in Settings. Checked
     segment is the gold thumb (same as the timeframe control's thumb);
     unchecked is transparent so the outline / stroke carries the shape.
     Pairs with segment_text.xml. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="@color/accent_gold" />
    <item android:color="@android:color/transparent" />
</selector>
