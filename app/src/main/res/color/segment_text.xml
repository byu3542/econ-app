<?xml version="1.0" encoding="utf-8"?>
<!-- TICKET-55 step 1: explicit label color for single-select segments in
     Settings (theme picker, startup tab). MDC's default checked-state text is
     colorPrimary (#1a1a2e, no values-night twin), which is invisible on the
     dark ground. Checked label sits on the gold thumb (segment_bg), so it is
     always header_navy; unchecked follows the theme's body text. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="@color/header_navy" />
    <item android:color="@color/text_navy" />
</selector>
