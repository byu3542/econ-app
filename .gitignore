# Local configuration — contains API keys, never commit
local.properties

# Built outputs — contain secrets baked in via BuildConfig
build/
app/build/
.gradle/
.kotlin/
*.apk
*.aab

# Android Studio
.idea/
*.iml
.DS_Store

# Keystore files
*.jks
*.keystore

# Local shortcuts / tool caches
*.lnk
proxy/.wrangler/

# Agent gate runtime artifacts (agent-autonomy plan, U4/U6).
# The hook configuration itself IS versioned — only its output is ignored.
.claude/gate.log
.claude/.gate_cache.json

# Python bytecode from the gate scripts
__pycache__/
*.pyc
