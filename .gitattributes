# Normalize line endings. Windows git had core.autocrlf on and no .gitattributes,
# so the tree showed 135 phantom modifications from the Linux side and zero from
# Windows. See docs/plans/2026-08-12-002-feat-agent-autonomy-plan.md (U2).
* text=auto

# Shell scripts MUST be LF or bash fails before running a line.
# scripts/check_badges.sh shipped with CRLF and exited 2 at line 26 for months
# while its onlyIf probe made the gate skip silently. That is U3.
*.sh text eol=lf

# Windows-native scripts stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
*.otf binary
*.jar binary
*.keystore binary
*.apk binary
